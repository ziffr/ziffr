SUPABASE_URL=http://127.0.0.1:55421
# local: `supabase status -o env` -> SERVICE_ROLE_KEY
SUPABASE_SERVICE_ROLE_KEY=

# Sign-in (ADR 0003). Where Ziffr is reached; sign-in links lead back here.
ZIFFR_SITE_URL=http://localhost:3000
# The anon key sign-in uses, read by the server when it runs (spec 0015). Locally `pnpm dev` reads it from
# `supabase status`; set it where Ziffr runs elsewhere. It is public by design. NEXT_PUBLIC_SUPABASE_URL and
# NEXT_PUBLIC_SUPABASE_ANON_KEY still work when SUPABASE_URL and this are not set.
# SUPABASE_ANON_KEY=
# Only when browsers reach Supabase Auth at another address than the server does (Docker sets it itself).
# SUPABASE_PUBLIC_URL=

# Sign-in providers offered besides the email link, comma separated: google, azure, github, linkedin_oidc.
# Each also needs its keys, read by Supabase (supabase/config.toml), e.g. for Google:
ZIFFR_AUTH_PROVIDERS=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
# SUPABASE_AUTH_EXTERNAL_AZURE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_AZURE_SECRET=
# SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=
# SUPABASE_AUTH_EXTERNAL_LINKEDIN_OIDC_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_LINKEDIN_OIDC_SECRET=

# Demo Mode (ADR 0005): "Try the demo" on the login page opens a made-up company beside the real workspaces.
# On by default; set to 0 to offer no demo.
# ZIFFR_DEMO=0
# A public demo and nothing else: the login page offers only the demo, nobody signs in, and sign-in links are refused.
# With Docker Compose, Auth also makes no accounts and the demo is reset every night (docker/README.md).
# ZIFFR_DEMO_ONLY=1
# Trial Workspaces (spec 0021, ADR 0010): anyone may sign in and make one workspace of their own, which ends after this
# many days (1 to 30) and is deleted a week later. Every Connector works in it but reaches only its Owner. Every
# workspace made on this Ziffr is then a trial. Leave ZIFFR_DEMO_ONLY unset; the demo stays offered beside it. A value
# that is set but wrong stops workspaces from being made. See docs/guides/self-hosting.md, "Offering trials".
# ZIFFR_TRIAL_DAYS=7
# How many trials may run at once (default 200).
# ZIFFR_TRIAL_MAX=200
# Workspace Limits (spec 0029): the most Metrics a Workspace may hold unless an Installation Admin gives it a limit of
# its own (Archived Metrics not counted). Unset means no limit. Over it, values never stop; only new Metrics wait,
# after 14 days with room for 10 % more. The name is what Owners and Admins see the default called.
# ZIFFR_DEFAULT_METRICS_LIMIT=10
# ZIFFR_DEFAULT_LIMIT_LABEL=Free
# Cloudflare Turnstile on the sign-in form, so bots cannot make a public Ziffr mail any address. Both or neither.
# ZIFFR_TURNSTILE_SITE_KEY=
# ZIFFR_TURNSTILE_SECRET=

# The user guide (docs/user-guide/README.md). The app shows the Markdown chapters in docs/user-guide at /guide. Set the
# URL to send the "User guide" link to a guide your team keeps elsewhere, or the folder to show other chapters.
# ZIFFR_USER_GUIDE_URL=https://wiki.example.com/ziffr
# ZIFFR_USER_GUIDE_DIR=

# Email (spec 0004). With both set, and ZIFFR_SITE_URL above for the links, the Email Connector sends real email
# through this SMTP server; without them messages stay in the Outbox only. Locally: smtp://127.0.0.1:55425 (Mailpit, shown at http://127.0.0.1:55424).
# An Installation Admin can set these on the Installation settings page (/installation) instead; a value here wins.
# ZIFFR_SMTP_URL=smtps://user:password@smtp.example.com:465
# ZIFFR_MAIL_FROM=Ziffr <ziffr@example.com>
# A scheduler calls POST /api/jobs/deliveries with "Authorization: Bearer <this>" every few minutes to retry sends
# that failed. At least 32 characters, e.g. `openssl rand -hex 32`; without it the job is off.
# ZIFFR_JOB_SECRET=
# Replies by email: each email gets the reply address reply+<token>@<this domain>. Your mail provider forwards
# replies to POST /api/inbound/email, signed with the secret (at least 32 characters); without both, emails say to
# answer in Ziffr instead.
# ZIFFR_INBOUND_DOMAIN=in.ziffr.example.com
# ZIFFR_INBOUND_SECRET=
# The name your mail provider writes first in its Authentication-Results header (its authserv-id). With it, a reply
# is taken only when the provider says DMARC or DKIM passed for the sender's domain; without it, a From address is
# not checked by anyone, so Approvals are never taken by email.
# ZIFFR_INBOUND_AUTHSERV_ID=mx.example.com
# Sign-in links through Ziffr's own mail settings (spec 0025): the secret of Supabase Auth's Send Email Hook, as
# Supabase shows it (v1,whsec_…). Docker makes and sets it by itself; with a hosted project, add the hook under
# Authentication, Hooks, pointing at <ZIFFR_SITE_URL>/api/auth/send-email.
# ZIFFR_AUTH_HOOK_SECRET=

# Slack (spec 0007, docs/guides/slack.md). Create the Slack app from the guide's manifest, then copy its client id,
# client secret and signing secret from its Basic Information page. With all four below and ZIFFR_SITE_URL, Owners
# and Admins can "Add to Slack" on the Connectors page; without them Slack stays simulated.
# ZIFFR_SLACK_CLIENT_ID=
# ZIFFR_SLACK_CLIENT_SECRET=
# ZIFFR_SLACK_SIGNING_SECRET=
# Seals the Slack bot tokens Ziffr stores (AES-256-GCM): 32 random bytes, e.g. `openssl rand -base64 32`. Keep it
# with your other secrets. To change it, put the old one in ZIFFR_SECRETS_KEY_PREVIOUS until every stored token was
# sealed again (docs/guides/slack.md).
# ZIFFR_SECRETS_KEY=
# ZIFFR_SECRETS_KEY_PREVIOUS=

# How many proxies in front of Ziffr add to X-Forwarded-For (usually 1), so sign-in limits can count per network
# address. Leave it unset when nothing in front of Ziffr sets that header.
# ZIFFR_PROXY_HOPS=1
# The remote MCP Server (spec 0023): assistants such as Claude.ai connect to <ZIFFR_SITE_URL>/mcp. On by default when
# ZIFFR_SITE_URL starts with https://, off otherwise; 1 turns it on (also for trying it on http://localhost), 0 off.
# Never on in a demo-only Ziffr.
# ZIFFR_REMOTE_MCP=1
# Only for GovSlack: its Web API instead of https://slack.com/api.
# ZIFFR_SLACK_API_URL=https://slack-gov.com/api

# Telegram (spec 0016). The token of a bot you made with @BotFather in Telegram; with it and ZIFFR_SECRETS_KEY above,
# Owners and Admins can turn Telegram on for their workspace. Telegram sends answers to ZIFFR_SITE_URL, which must be
# https; on a laptop without a public address, set ZIFFR_TELEGRAM_POLLING=1 and run `pnpm telegram:poll` next to
# `pnpm dev`, which fetches answers through a job (it needs ZIFFR_JOB_SECRET above).
# ZIFFR_TELEGRAM_BOT_TOKEN=
# ZIFFR_TELEGRAM_POLLING=1
# Only for a Bot API server of your own, instead of https://api.telegram.org.
# ZIFFR_TELEGRAM_API_URL=

# Installation Admins (spec 0025): addresses of the people who run this Installation, separated by commas. They open
# /installation without the one-time setup code Ziffr writes to its log while it has no Installation Admin.
# ZIFFR_INSTALLATION_ADMINS=you@example.com
# A mail server inside this server's network (localhost, 10.x, a Docker service) may be saved on that page only with:
# ZIFFR_ALLOW_PRIVATE_MAIL_HOST=1
