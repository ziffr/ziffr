SUPABASE_URL=http://127.0.0.1:55421
# local: `supabase status -o env` -> SERVICE_ROLE_KEY
SUPABASE_SERVICE_ROLE_KEY=

# Sign-in (ADR 0003). Where Ziffr is reached; sign-in links lead back here.
ZIFFR_SITE_URL=http://localhost:3000
# The anon key sign-in uses, read by the server when it runs (spec 0015). Locally `pnpm dev` reads it from
# `supabase status`; set it where Ziffr runs elsewhere. It is public by design. NEXT_PUBLIC_SUPABASE_URL and
# NEXT_PUBLIC_SUPABASE_ANON_KEY still work when SUPABASE_URL and this are not set.
# SUPABASE_ANON_KEY=
# Only when browsers reach Supabase Auth at another address than the server does (Docker sets it itself).
# SUPABASE_PUBLIC_URL=

# Sign-in providers offered besides the email link, comma separated: google, azure, github, linkedin_oidc.
# Each also needs its keys, read by Supabase (supabase/config.toml), e.g. for Google:
ZIFFR_AUTH_PROVIDERS=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
# SUPABASE_AUTH_EXTERNAL_AZURE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_AZURE_SECRET=
# SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=
# SUPABASE_AUTH_EXTERNAL_LINKEDIN_OIDC_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_LINKEDIN_OIDC_SECRET=

# Demo Mode (ADR 0005): "Try the demo" on the login page opens a made-up company beside the real workspaces.
# On by default; set to 0 to offer no demo.
# (The demo, trials and the check against bots can also be set on the Installation settings page; a value here wins.)
# A public demo and nothing else: the login page offers only the demo, nobody signs in, and sign-in links are refused.
# With Docker Compose, Auth also makes no accounts and the demo is reset every night (docker/README.md).
# ZIFFR_DEMO_ONLY=1
# Trial Workspaces (spec 0021, ADR 0010): anyone may sign in and make one workspace of their own, which ends after this
# many days (1 to 30) and is deleted a week later. Every Connector works in it but reaches only its Owner. Every
# workspace made on this Ziffr is then a trial. Leave ZIFFR_DEMO_ONLY unset; the demo stays offered beside it. A value
# that is set but wrong stops workspaces from being made. See docs/guides/self-hosting.md, "Offering trials".
# How many trials may run at once (default 200).
# What becomes of a trial at its end (spec 0029): delete (the default) or keep, which turns it into an ordinary
# Workspace on the default Workspace Limit below. With 1, each person may own only one Workspace on that default.
# ZIFFR_ONE_DEFAULT_PER_PERSON=1
# Workspace Limits (spec 0029): the most Metrics a Workspace may hold unless an Installation Admin gives it a limit of
# its own (Archived Metrics not counted). Unset means no limit. Over it, values never stop; only new Metrics wait,
# after 14 days with room for 10 % more. The name is what Owners and Admins see the default called.
# Ziffr Cloud (spec 0029): hosted Ziffr's billing service, for the hosted Installation only. Self-hosters leave both
# unset; then the Cloud API answers 404 and no Size buttons show. The key signs the API's calls and the Owners'
# handover: at least 32 characters, in the environment only, never on the Installation Settings page. Trials exist
# only where it is set (spec 0040); a ZIFFR_TRIAL_* setting without it is ignored.
# ZIFFR_CLOUD_KEY=
# ZIFFR_CLOUD_URL=https://cloud.example.com
# Feedback bridge (spec 0049), hosted Ziffr only: the Ziffr bot's GitHub token (Issues and Discussions write on one
# repository), the repository as owner/name and the id of the Discussion category for ideas and questions. Server only.
# One GitHub account is enough: it may post the feedback and also be the account the team answers from. Only the
# comments Ziffr itself relays (they carry the relay marker) are left out of the answers; type an answer as a plain comment. If the account is a member of an organisation with private membership, GitHub
# reports its comments as CONTRIBUTOR or NONE and they are ignored: make the membership public.
# ZIFFR_FEEDBACK_GITHUB_TOKEN=
# ZIFFR_FEEDBACK_GITHUB_REPO=ziffr/ziffr
# ZIFFR_FEEDBACK_GITHUB_CATEGORY_ID=
# Answers coming back (spec 0049): the secret of the repository's GitHub webhook (events: Issues, Issue comments,
# Discussions, Discussion comments; address /api/inbound/feedback-github; content type application/json), at least 32
# characters. Without it the address answers 404.
# ZIFFR_FEEDBACK_GITHUB_WEBHOOK_SECRET=
# The Marketplace (spec 0030): off unless on. Ziffr's server then asks the Marketplace for Packs, their files and newer
# versions, sending no Workspace's or person's data. The address is Ziffr's own unless set; never inside this server's
# network unless ZIFFR_ALLOW_PRIVATE_MARKETPLACE=1. ZIFFR_MARKETPLACE_PUBLIC_KEY adds a key whose signatures Ziffr
# trusts (base64 of the raw 32-byte Ed25519 key), for a Marketplace of your own. Also on the Installation Settings page,
# except the key and the private-network switch.
# ZIFFR_MARKETPLACE_PUBLIC_KEY=
# ZIFFR_ALLOW_PRIVATE_MARKETPLACE=1
# With a default limit: days without a sign-in or a value after which a Workspace on it is warned, and deleted with
# its key 14 days later if still unused (30 to 3650). Unset: never. Never a trial, the demo or a Workspace with a
# limit of its own. The scheduler calls POST /api/jobs/unused-workspaces daily.
# Sending limits (ticket #516): the abuse safeguards, each moved within its range; none can be switched off, and a value
# outside its range is ignored. The same for every Workspace. Also on the Installation Settings page; a value here wins.
# Lowering one never deletes or stops what exists. Defaults shown; ranges are on the page and in docs/user-guide/18.
# Days from the warning to the deletion of an unused Workspace (7 to 90, default 14; the days a warning promised stay).
# ZIFFR_UNUSED_WAIT_DAYS=14
# Days over the Workspace Limit before new Metrics wait (0 to 90, default 14), and days before a Workspace may have
# such a period again (0 to 730, default 90).
# ZIFFR_LIMIT_GRACE_DAYS=14
# ZIFFR_LIMIT_GRACE_EVERY_DAYS=90
# How long logs are kept, in days (spec 0025; also on the Installation Settings page). The Audit Log: 365 to 3650,
# default 730, never fewer days than a Retention or an Approval still refers to. The log of calls by key: 7 to 730,
# default 90. The log of Webhook sends: 1 to 90, default 14. View Counts: 90 to 800, default 400. A value outside its
# range is not used; the default applies. On a Ziffr Cloud deployment (ZIFFR_CLOUD_KEY) the Workspace Limits, the grace
# days, the trial days and the unused-Workspace wait are fixed by Ziffr Cloud and the page cannot change them.
# ZIFFR_KEEP_AUDIT_DAYS=730
# ZIFFR_KEEP_ACCESS_LOG_DAYS=90
# ZIFFR_KEEP_WEBHOOK_LOG_DAYS=14
# ZIFFR_KEEP_VIEW_COUNT_DAYS=400
# The most original values one Metric's Retention takes in a night (500 to 100000, default 5000).
# ZIFFR_RETENTION_VALUES_PER_RUN=5000
# Cloudflare Turnstile on the sign-in form, so bots cannot make a public Ziffr mail any address. Both or neither.

# The user guide (docs/user-guide/README.md). The app shows the Markdown chapters in docs/user-guide at /guide. Set the
# URL to send the "User guide" link to a guide your team keeps elsewhere, or the folder to show other chapters.
# ZIFFR_USER_GUIDE_URL=https://wiki.example.com/ziffr
# ZIFFR_USER_GUIDE_DIR=

# Email (spec 0004). With both set, and ZIFFR_SITE_URL above for the links, the Email Connector sends real email
# through this SMTP server; without them messages stay in the Outbox only. Locally: smtp://127.0.0.1:55425 (Mailpit, shown at http://127.0.0.1:55424).
# An Installation Admin can set these on the Installation settings page (/installation) instead; a value here wins.
# A scheduler calls POST /api/jobs/deliveries with "Authorization: Bearer <this>" every few minutes to retry sends
# that failed. At least 32 characters, e.g. `openssl rand -hex 32`; without it the job is off.
# ZIFFR_JOB_SECRET=
# Replies by email: each email gets the reply address reply+<token>@<this domain>. Your mail provider forwards
# replies to POST /api/inbound/email, signed with the secret (at least 32 characters); without both, emails say to
# answer in Ziffr instead.
# The name your mail provider writes first in its Authentication-Results header (its authserv-id). With it, a reply
# is taken at once only when the provider says DMARC or DKIM passed for the sender's domain; otherwise it is held
# until the person confirms it by a link emailed to the address on file, and Approvals are never taken by email.
# Sign-in links through Ziffr's own mail settings (spec 0025): the secret of Supabase Auth's Send Email Hook, as
# Supabase shows it (v1,whsec_…). Docker makes and sets it by itself; with a hosted project, add the hook under
# Authentication, Hooks, pointing at <ZIFFR_SITE_URL>/api/auth/send-email.
# ZIFFR_AUTH_HOOK_SECRET=

# Slack (spec 0007, docs/guides/slack.md). Create the Slack app from the guide's manifest, then copy its client id,
# client secret and signing secret from its Basic Information page. With all four below and ZIFFR_SITE_URL, Owners
# and Admins can "Add to Slack" on the Connectors page; without them Slack stays simulated.
# Seals the Slack bot tokens Ziffr stores (AES-256-GCM): 32 random bytes, e.g. `openssl rand -base64 32`. Keep it
# with your other secrets. To change it, put the old one in ZIFFR_SECRETS_KEY_PREVIOUS until every stored token was
# sealed again (docs/guides/slack.md).
# ZIFFR_SECRETS_KEY=
# ZIFFR_SECRETS_KEY_PREVIOUS=

# An address of its own for the Installation settings (spec 0066), such as https://admin.example.com. When set, those
# pages answer only there, and that address serves only signing in and them. Restrict who reaches it at your network
# (docs/guides/self-hosting.md). Add <this address>/auth/callback to the redirect URLs of your own Supabase project.
# ZIFFR_ADMIN_URL=

# How many proxies in front of Ziffr add to X-Forwarded-For (usually 1), so sign-in limits can count per network
# address. Leave it unset when nothing in front of Ziffr sets that header.
# ZIFFR_PROXY_HOPS=1
# A secret of at least 32 characters (for example `openssl rand -hex 32`) that a demo-only Ziffr, where visitors may
# change the demo, uses to count changes per network address without keeping the address (a keyed hash; spec 0051).
# Without it, or without ZIFFR_PROXY_HOPS, visitors' changes are refused. Never share it, never change it casually: a
# new one only starts every address's count again.
# ZIFFR_DEMO_ADDRESS_KEY=
# The remote MCP Server (spec 0023): assistants such as Claude.ai connect to <ZIFFR_SITE_URL>/mcp. On by default when
# ZIFFR_SITE_URL starts with https://, off otherwise; 1 turns it on (also for trying it on http://localhost), 0 off.
# Never on in a demo-only Ziffr.
# ZIFFR_REMOTE_MCP=1
# Only for GovSlack: its Web API instead of https://slack.com/api.
# ZIFFR_SLACK_API_URL=https://slack-gov.com/api

# Telegram (spec 0016). The token of a bot you made with @BotFather in Telegram; with it and ZIFFR_SECRETS_KEY above,
# Owners and Admins can turn Telegram on for their workspace. Telegram sends answers to ZIFFR_SITE_URL, which must be
# https; on a laptop without a public address, set ZIFFR_TELEGRAM_POLLING=1 and run `pnpm telegram:poll` next to
# `pnpm dev`, which fetches answers through a job (it needs ZIFFR_JOB_SECRET above).
# ZIFFR_TELEGRAM_POLLING=1
# Only for a Bot API server of your own, instead of https://api.telegram.org.
# ZIFFR_TELEGRAM_API_URL=

# Installation Admins (spec 0025): addresses of the people who run this Installation, separated by commas. They open
# /installation without the one-time setup code Ziffr writes to its log while it has no Installation Admin.
# ZIFFR_INSTALLATION_ADMINS=you@example.com
# A mail server inside this server's network (localhost, 10.x, a Docker service) may be saved on that page only with:
# ZIFFR_ALLOW_PRIVATE_MAIL_HOST=1

# Every Installation Setting, generated from the catalogue (packages/core/src/installation-catalogue.ts); `pnpm test` fails
# when this list is out of date. Any of them can also be set on the Installation settings page; a value here wins.
# generated:installation-settings
# Mail
# ZIFFR_SMTP_URL=
# ZIFFR_MAIL_FROM=Ziffr <ziffr@example.com>
# Replies by email
# ZIFFR_INBOUND_DOMAIN=in.ziffr.example.com
# ZIFFR_INBOUND_SECRET=
# ZIFFR_INBOUND_AUTHSERV_ID=mx.example.com
# Telegram
# ZIFFR_TELEGRAM_BOT_TOKEN=
# Slack
# ZIFFR_SLACK_CLIENT_ID=1234567890.1234567890
# ZIFFR_SLACK_CLIENT_SECRET=
# ZIFFR_SLACK_SIGNING_SECRET=
# Slide editor
# ZIFFR_TLDRAW_LICENSE_KEY=tldraw-…
# Workspace Limits
# ZIFFR_DEFAULT_METRICS_LIMIT=
# ZIFFR_DEFAULT_LIMIT_LABEL=Standard
# ZIFFR_DELETE_UNUSED_AFTER_DAYS=
# ZIFFR_LIMIT_GRACE_DAYS=14
# ZIFFR_LIMIT_GRACE_EVERY_DAYS=90
# ZIFFR_UNUSED_WAIT_DAYS=14
# Sending limits
# ZIFFR_LIMIT_EMAILS_PER_WORKSPACE_PER_DAY=500
# ZIFFR_LIMIT_CHAT_MESSAGES_PER_WORKSPACE_PER_DAY=500
# ZIFFR_LIMIT_EMAILS_PER_PERSON_PER_DAY=300
# ZIFFR_LIMIT_SEND_ATTEMPTS=5
# ZIFFR_LIMIT_ALERTS_PER_WORKSPACE=500
# ZIFFR_LIMIT_ALERT_MESSAGES_PER_WORKSPACE_PER_DAY=2000
# ZIFFR_LIMIT_INVITATION_EMAILS_PER_WORKSPACE_PER_DAY=50
# ZIFFR_LIMIT_VALUES_PER_KEY_PER_DAY=1000
# ZIFFR_LIMIT_VALUES_PER_FEED_PER_DAY=10000
# ZIFFR_LIMIT_CALLS_PER_KEY_PER_MINUTE=60
# ZIFFR_LIMIT_WEBHOOKS_PER_WORKSPACE=5
# ZIFFR_LIMIT_WEBHOOK_SENDS_PER_WORKSPACE_PER_DAY=10000
# ZIFFR_LIMIT_SIGN_IN_LINKS_PER_NETWORK_PER_HOUR=20
# ZIFFR_LIMIT_CONTACTS_PER_WORKSPACE=1000
# ZIFFR_LIMIT_SNAPSHOTS_PER_DASHBOARD=500
# ZIFFR_LIMIT_ALERTS_PER_PERSON=20
# ZIFFR_LIMIT_ALERT_MESSAGES_PER_PERSON_PER_DAY=20
# How long logs are kept
# ZIFFR_KEEP_AUDIT_DAYS=730
# ZIFFR_KEEP_ACCESS_LOG_DAYS=90
# ZIFFR_KEEP_WEBHOOK_LOG_DAYS=14
# ZIFFR_KEEP_VIEW_COUNT_DAYS=400
# ZIFFR_RETENTION_VALUES_PER_RUN=5000
# Marketplace
# ZIFFR_MARKETPLACE=
# ZIFFR_MARKETPLACE_URL=https://marketplace.ziffr.net
# Check against bots
# ZIFFR_TURNSTILE_SITE_KEY=0x4AAAAAAA…
# ZIFFR_TURNSTILE_SECRET=
# Trial Limits
# ZIFFR_TRIAL_DAYS=30
# ZIFFR_TRIAL_GRACE_DAYS=7
# ZIFFR_TRIAL_MAX=500
# ZIFFR_TRIAL_LIMIT_PEOPLE=5
# ZIFFR_TRIAL_LIMIT_INVITATIONS_PER_DAY=10
# ZIFFR_TRIAL_LIMIT_INVITATIONS_ALL_PER_DAY=500
# ZIFFR_TRIAL_LIMIT_METRICS=25
# ZIFFR_TRIAL_LIMIT_MESSAGES_PER_DAY=100
# ZIFFR_TRIAL_LIMIT_KEYS=2
# ZIFFR_TRIAL_LIMIT_FEEDS=2
# ZIFFR_TRIAL_LIMIT_ASSISTANTS=1
# ZIFFR_TRIAL_LIMIT_WEBHOOKS=2
# ZIFFR_TRIAL_LIMIT_WEBHOOK_SENDS_PER_DAY=200
# ZIFFR_TRIAL_LIMIT_VIEW_LINKS=5
# Usage
# ZIFFR_USAGE_EXCLUDE_WORKSPACE=
# Feedback
# ZIFFR_FEEDBACK_PROMPT=true
# ZIFFR_FEEDBACK_MODE=direct
# ZIFFR_FEEDBACK_PER_DAY=200
# Demo
# ZIFFR_DEMO=1
# ZIFFR_DEMO_CHANGES=1
# /generated:installation-settings
