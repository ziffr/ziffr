{
  "name": "ziffr",
  "version": "0.11.0",
  "private": true,
  "license": "BUSL-1.1",
  "scripts": {
    "prototype": "supabase start && pnpm --filter @ziffr/web dev",
    "prototype:fast": "supabase start && pnpm --filter @ziffr/web preview",
    "prototype:reset": "supabase db reset",
    "prototype:stop": "supabase stop",
    "dev": "pnpm --filter @ziffr/web dev",
    "demo": "pnpm --filter @ziffr/web dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint && pnpm -s guards",
    "guards": "node .github/scripts/client-imports.mjs && node .github/scripts/app-db-access.mjs",
    "test": "pnpm -r --if-present test && node --test scripts/*.test.mjs",
    "health": "knip && node scripts/code-health.mjs",
    "health:worst": "node scripts/code-health.mjs --worst",
    "changeset": "changeset",
    "release": "node scripts/release.mjs",
    "ci:local": "bash scripts/ci-local.sh",
    "telegram:poll": "node --env-file-if-exists=.env.local scripts/telegram-poll.mjs"
  },
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "jscpd": "5.4.3",
    "knip": "6.45.1",
    "supabase": "2.116.0",
    "vite": "7.3.8"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.23": "8.5.23",
      "sharp@<0.35.5": "^0.35.5",
      "image-size@<2.0.3": "^2.0.3",
      "minimatch@>=10 <11.0.1": "^11.0.1"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-f88m-g3jw-g9cj",
        "GHSA-rgj7-g3m4-5g8c",
        "GHSA-wq5f-xc86-pv6w",
        "GHSA-5p2g-fcmc-qvqq",
        "GHSA-w3rx-r6r6-pgpr"
      ]
    }
  }
}
