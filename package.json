{
  "name": "ziffr",
  "version": "0.6.0",
  "private": true,
  "license": "BUSL-1.1",
  "scripts": {
    "prototype": "supabase start && pnpm --filter @ziffr/web dev",
    "prototype:fast": "supabase start && pnpm --filter @ziffr/web preview",
    "prototype:reset": "supabase db reset",
    "prototype:stop": "supabase stop",
    "dev": "pnpm --filter @ziffr/web dev",
    "demo": "pnpm --filter @ziffr/web dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test && node --test scripts/*.test.mjs",
    "changeset": "changeset",
    "release": "node scripts/release.mjs",
    "ci:local": "bash scripts/ci-local.sh"
  },
  "packageManager": "pnpm@10.30.3",
  "devDependencies": {
    "@changesets/cli": "^3.0.3"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.23": "8.5.23"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-f88m-g3jw-g9cj",
        "GHSA-rgj7-g3m4-5g8c",
        "GHSA-wq5f-xc86-pv6w",
        "GHSA-5p2g-fcmc-qvqq",
        "GHSA-w3rx-r6r6-pgpr"
      ]
    }
  }
}
