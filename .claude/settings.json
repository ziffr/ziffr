{
  "permissions": {
    "allow": [
      "Bash(pnpm exec tsc --noEmit)",
      "Bash(pnpm lint)",
      "Bash(pnpm test)",
      "Bash(supabase status)",
      "Bash(git status)",
      "Bash(git status --short)",
      "Bash(git diff)",
      "Bash(git diff --stat)",
      "Bash(git log --oneline -20)"
    ],
    "deny": [
      "Read(./.env*)",
      "Read(./**/.env*)",
      "Edit(./.env*)",
      "Write(./.env*)",
      "Bash(git push:*)",
      "Bash(supabase db reset --linked:*)",
      "Bash(supabase db push:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Read|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-files.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lint-file.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-before-stop.sh",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
