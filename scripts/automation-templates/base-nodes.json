  "remember": {
    "parameters": {
      "jsCode": "// Writes down what Ziffr took (200: done; 409: Ziffr's rules say no, asking again would not help), so it is not sent twice.\nconst state = $getWorkflowStaticData('global');\nstate.reported = state.reported || {};\nstate.replied = state.replied || {};\nconst sent = $('Sign request').all();\nlet handled = 0;\n$input.all().forEach((res, i) => {\n  const s = sent[i] && sent[i].json;\n  const code = res.json.statusCode;\n  if (!s || (code !== 200 && code !== 409)) return;\n  handled++;\n  if (s.op === 'done') state.reported[s.ref] = 'done';\n  if (s.op === 'reopen') state.reported[s.ref] = 'open';\n  if (s.op === 'reply') state.replied[s.ref] = s.text;\n});\nreturn [{ json: { handled } }];\n"
    },
    "id": "9e5f1725-f8e3-c7c6-1df9-94e06958dcca",
    "name": "Remember what Ziffr took",
    "type": "n8n-nodes-base.code",
    "typeVersion": 2,
