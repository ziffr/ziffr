          "x": {
            "type": "integer",
            "minimum": 0,
            "maximum": 11
          },
          "y": {
            "type": "integer",
            "minimum": 0,
            "maximum": 400
          },
          "w": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "h": {
            "type": "integer",
            "minimum": 2,
            "maximum": 24
          }
        },
        "required": [
          "view",
          "slots",
          "x",
          "y",
          "w",
          "h"
        ],
        "additionalProperties": false
      }
    }
