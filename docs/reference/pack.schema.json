{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ziffr.net/schemas/ziffr.pack-1.json",
  "title": "Ziffr Pack (ziffr.pack/1)",
  "description": "A file of things to add to a Workspace, with no code: Metric Catalog entries, Dashboard and Deck Templates, View Designs, Analysis Recipes, Workflow Templates and Themes, with its name, version, author and license.",
  "type": "object",
  "properties": {
    "format": {
      "const": "ziffr.pack/1",
      "description": "The format and its version."
    },
    "id": {
      "type": "string",
      "maxLength": 100,
      "pattern": "^[a-z0-9][a-z0-9-]{0,38}/[a-z0-9][a-z0-9-]{0,59}$",
      "description": "the creator's Marketplace handle and a slug, such as “ziffr/saas-metrics”, the same for every version"
    },
    "name": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^(?![\\s\\S]*(?:://|[Ww][Ww][Ww]\\.|[Jj][Aa][Vv][Aa][Ss][Cc][Rr][Ii][Pp][Tt]:|[Dd][Aa][Tt][Aa]:|[Uu][Rr][Ll]\\(|[\\p{L}\\p{N}](?:\\.(?:[Cc][Oo][Mm]|[Nn][Ee][Tt]|[Oo][Rr][Gg]|[Ii][Oo]|[Cc][Oo]|[Ii][Nn][Ff][Oo]|[Bb][Ii][Zz]|[Aa][Pp][Pp]|[Dd][Ee][Vv]|[Xx][Yy][Zz]|[Mm][Ee]|[Aa][Ii]|[Ll][Yy]|[Gg][Ll]|[Gg][Gg]|[Tt][Oo]|[Cc][Cc]|[Tt][Vv]|[Ww][Ss]|[Ll][Ii][Nn][Kk]|[Cc][Ll][Ii][Cc][Kk]|[Ss][Ii][Tt][Ee]|[Oo][Nn][Ll][Ii][Nn][Ee]|[Tt][Oo][Pp]|[Tt][Kk]|[Rr][Uu]|[Cc][Nn]|[Dd][Ee]|[Uu][Kk]|[Ff][Rr]|[Ee][Uu]|[Uu][Ss]|[Nn][Ll]|[Cc][Hh]|[Aa][Tt]|[Ii][Tt]|[Ee][Ss])(?![\\p{L}\\p{N}])|\\.[Xx][Nn]--|\\.\\p{L}{2,}/)|\\b(?:[Hh][Tt][Tt][Pp][Ss]?|[Ff][Tt][Pp]|[Mm][Aa][Ii][Ll][Tt][Oo]|[Tt][Ee][Ll]|[Ss][Mm][Ss]|[Ff][Ii][Ll][Ee]|[Vv][Bb][Ss][Cc][Rr][Ii][Pp][Tt]):(?!\\s)))[\\p{L}\\p{M}\\p{N} .,;:!?'\"’‘“”«»()%€$£¥+\\-–—/&#*=_·…°]*$",
      "description": "plain text, without markup or web addresses",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "maxLength": 20,
      "pattern": "^(?:0|[1-9][0-9]{0,5})\\.(?:0|[1-9][0-9]{0,5})\\.(?:0|[1-9][0-9]{0,5})$",
      "description": "three numbers, major, minor and patch, such as “1.2.0”"
    },
    "summary": {
      "type": "string",
      "maxLength": 300,
      "pattern": "^(?![\\s\\S]*(?:://|[Ww][Ww][Ww]\\.|[Jj][Aa][Vv][Aa][Ss][Cc][Rr][Ii][Pp][Tt]:|[Dd][Aa][Tt][Aa]:|[Uu][Rr][Ll]\\(|[\\p{L}\\p{N}](?:\\.(?:[Cc][Oo][Mm]|[Nn][Ee][Tt]|[Oo][Rr][Gg]|[Ii][Oo]|[Cc][Oo]|[Ii][Nn][Ff][Oo]|[Bb][Ii][Zz]|[Aa][Pp][Pp]|[Dd][Ee][Vv]|[Xx][Yy][Zz]|[Mm][Ee]|[Aa][Ii]|[Ll][Yy]|[Gg][Ll]|[Gg][Gg]|[Tt][Oo]|[Cc][Cc]|[Tt][Vv]|[Ww][Ss]|[Ll][Ii][Nn][Kk]|[Cc][Ll][Ii][Cc][Kk]|[Ss][Ii][Tt][Ee]|[Oo][Nn][Ll][Ii][Nn][Ee]|[Tt][Oo][Pp]|[Tt][Kk]|[Rr][Uu]|[Cc][Nn]|[Dd][Ee]|[Uu][Kk]|[Ff][Rr]|[Ee][Uu]|[Uu][Ss]|[Nn][Ll]|[Cc][Hh]|[Aa][Tt]|[Ii][Tt]|[Ee][Ss])(?![\\p{L}\\p{N}])|\\.[Xx][Nn]--|\\.\\p{L}{2,}/)|\\b(?:[Hh][Tt][Tt][Pp][Ss]?|[Ff][Tt][Pp]|[Mm][Aa][Ii][Ll][Tt][Oo]|[Tt][Ee][Ll]|[Ss][Mm][Ss]|[Ff][Ii][Ll][Ee]|[Vv][Bb][Ss][Cc][Rr][Ii][Pp][Tt]):(?!\\s)))[\\p{L}\\p{M}\\p{N} .,;:!?'\"’‘“”«»()%€$£¥+\\-–—/&#*=_·…°]*$",
      "description": "plain text, without markup or web addresses",
      "minLength": 1
    },
    "author": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^(?![\\s\\S]*(?:://|[Ww][Ww][Ww]\\.|[Jj][Aa][Vv][Aa][Ss][Cc][Rr][Ii][Pp][Tt]:|[Dd][Aa][Tt][Aa]:|[Uu][Rr][Ll]\\(|[\\p{L}\\p{N}](?:\\.(?:[Cc][Oo][Mm]|[Nn][Ee][Tt]|[Oo][Rr][Gg]|[Ii][Oo]|[Cc][Oo]|[Ii][Nn][Ff][Oo]|[Bb][Ii][Zz]|[Aa][Pp][Pp]|[Dd][Ee][Vv]|[Xx][Yy][Zz]|[Mm][Ee]|[Aa][Ii]|[Ll][Yy]|[Gg][Ll]|[Gg][Gg]|[Tt][Oo]|[Cc][Cc]|[Tt][Vv]|[Ww][Ss]|[Ll][Ii][Nn][Kk]|[Cc][Ll][Ii][Cc][Kk]|[Ss][Ii][Tt][Ee]|[Oo][Nn][Ll][Ii][Nn][Ee]|[Tt][Oo][Pp]|[Tt][Kk]|[Rr][Uu]|[Cc][Nn]|[Dd][Ee]|[Uu][Kk]|[Ff][Rr]|[Ee][Uu]|[Uu][Ss]|[Nn][Ll]|[Cc][Hh]|[Aa][Tt]|[Ii][Tt]|[Ee][Ss])(?![\\p{L}\\p{N}])|\\.[Xx][Nn]--|\\.\\p{L}{2,}/)|\\b(?:[Hh][Tt][Tt][Pp][Ss]?|[Ff][Tt][Pp]|[Mm][Aa][Ii][Ll][Tt][Oo]|[Tt][Ee][Ll]|[Ss][Mm][Ss]|[Ff][Ii][Ll][Ee]|[Vv][Bb][Ss][Cc][Rr][Ii][Pp][Tt]):(?!\\s)))[\\p{L}\\p{M}\\p{N} .,;:!?'\"’‘“”«»()%€$£¥+\\-–—/&#*=_·…°]*$",
          "description": "plain text, without markup or web addresses",
          "minLength": 1
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "license": {
      "enum": [
        "CC-BY-4.0",
        "MIT",
        "Ziffr-Pack-1.0"
      ],
      "description": "CC-BY-4.0 or MIT for a free Pack, Ziffr-Pack-1.0 for a paid one."
    },
    "ziffr": {
      "type": "string",
      "maxLength": 20,
      "pattern": "^>=(?:0|[1-9][0-9]{0,3})\\.(?:0|[1-9][0-9]{0,3})(?:\\.(?:0|[1-9][0-9]{0,3}))?$",
      "description": "the oldest Ziffr that can install it, such as “>=0.12”"
    },
    "audience": {
      "type": "object",
      "description": "Whom the Pack is for, so Ziffr can suggest it to a Workspace that fits and rank it higher. It never hides the Pack from anyone. Every part is optional and lists distinct keys from Ziffr's fixed lists; at least one part is needed (leave the field out instead of leaving it empty). A Pack that uses it must state a `ziffr` minimum, such as \">=0.16\", since an older Ziffr refuses the field.",
      "properties": {
        "industries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 18,
          "uniqueItems": true,
          "items": {
            "enum": [
              "saas",
              "ecommerce",
              "retail",
              "wholesale",
              "manufacturing",
              "construction",
              "real_estate",
              "professional_services",
              "agency",
              "financial_services",
              "healthcare",
              "education",
              "hospitality",
              "logistics",
              "energy",
              "media",
              "agriculture",
              "other"
            ]
          },
          "description": "the industries it is for"
        },
        "segments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "b2b",
              "b2c",
              "b2b2c",
              "public_sector",
              "non_profit"
            ]
          },
          "description": "who the business sells to or serves"
        },
        "functions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 9,
          "uniqueItems": true,
          "items": {
            "enum": [
              "sales",
              "marketing",
              "finance",
              "operations",
              "customer_support",
              "people",
              "product_engineering",
              "management",
              "other"
            ]
          },
          "description": "the Business Functions it is for"
        },
        "employeeBands": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": [
              "1-10",
              "11-50",
              "51-200",
              "201-500",
              "501-1000",
              "1000+"
            ]
          },
          "description": "how many people work there"
        },
        "revenueBands": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": [
              "<1m",
              "1m-10m",
              "10m-50m",
              "50m-250m",
              "250m-1b",
              "1b+"
            ]
          },
          "description": "a year's revenue"
        },
        "countries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 2
          },
          "description": "ISO 3166-1 alpha-2 country codes, such as “DE”"
        }
      },
      "additionalProperties": false
    },
    "logo": {
      "type": "string",
      "maxLength": 170697,
      "pattern": "^data:image/(?:png|jpeg|svg\\+xml);base64,[A-Za-z0-9+/]+={0,2}$",
      "description": "The Pack's one logo, as a PNG, JPEG or plain SVG data address: at most 128,000 bytes and 512 pixels on each side. Shown only in a bordered box on the Packs page and the Marketplace; Themes of the Pack may use it with \"logo\": \"pack\"."
    },
    "listing": {
      "type": "object",
      "description": "The only place a Pack may hold web addresses, shown on its pages as plain links.",
      "properties": {
        "homepage": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^https://[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,62}[a-zA-Z0-9])?(?:\\.[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,62}[a-zA-Z0-9])?)+(?::[0-9]{1,5})?(?:/[A-Za-z0-9._~%!$&'()*+,;=:@/-]*)?(?:\\?[A-Za-z0-9._~%!$&'()*+,;=:@/?-]*)?$",
          "description": "an https address, such as “https://example.com/help”"
        },
        "support": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^https://[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,62}[a-zA-Z0-9])?(?:\\.[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,62}[a-zA-Z0-9])?)+(?::[0-9]{1,5})?(?:/[A-Za-z0-9._~%!$&'()*+,;=:@/-]*)?(?:\\?[A-Za-z0-9._~%!$&'()*+,;=:@/?-]*)?$",
          "description": "an https address, such as “https://example.com/help”"
        }
      },
      "additionalProperties": false
    },
    "feeds": {
      "type": "array",
      "maxItems": 10,
      "description": "Which of Ziffr's n8n templates fill which of the Pack's Metric Catalog entries (spec 0043). Only ids Ziffr ships are accepted. Installing makes nothing of it: after Set up, the page offers the download for the Metrics made from the entries. A Pack that uses it should say so in its `ziffr` minimum version.",
      "items": {
        "type": "object",
        "properties": {
          "template": {
            "enum": [
              "google-sheets",
              "excel",
              "stripe",
              "hubspot",
              "bigquery",
              "snowflake"
            ],
            "description": "the id of one of the templates Ziffr ships, such as “google-sheets”"
          },
          "fills": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,39}$",
              "description": "the key of a Metric Catalog entry of this Pack the template fills"
            }
          }
        },
        "required": [
          "template",
          "fills"
        ],
        "additionalProperties": false
      }
    },
    "contents": {
      "type": "object",
      "description": "What installing adds. Nothing in it may hold a web address.",
      "properties": {
        "metrics": {
          "type": "array",
          "maxItems": 50,
          "description": "Metric Catalog entries, each a ziffr.metric/1 document under “metric”.",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,39}$",
                "description": "a key unique in the Pack and kept across its versions: lower-case letters, digits and dashes"
              },
              "metric": {
                "type": "object",
                "description": "A ziffr.metric/1 document, checked by its own schema."
              }
            },
            "required": [
              "key",
              "metric"
            ],
            "additionalProperties": false
          }
        },
        "dashboards": {
          "type": "array",
          "maxItems": 50,
          "description": "Dashboard Templates, each a ziffr.dashboard-template/1 document under “template”.",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,39}$",
                "description": "a key unique in the Pack and kept across its versions: lower-case letters, digits and dashes"
              },
              "template": {
                "type": "object",
                "description": "A ziffr.dashboard-template/1 document, checked by its own schema."
              }
            },
            "required": [
              "key",
              "template"
            ],
            "additionalProperties": false
          }
        },
        "views": {
          "type": "array",
          "maxItems": 50,
          "description": "View Designs, each a ziffr.view/1 document under “design”.",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,39}$",
                "description": "a key unique in the Pack and kept across its versions: lower-case letters, digits and dashes"
              },
              "design": {
                "type": "object",
                "description": "A ziffr.view/1 document, checked by its own schema."
              }
            },
            "required": [
              "key",
              "design"
            ],
            "additionalProperties": false
          }
        },
        "analyses": {
          "type": "array",
          "maxItems": 50,
          "description": "Analysis Recipes, each a ziffr.analysis/1 or ziffr.analysis/2 document under “recipe”.",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,39}$",
                "description": "a key unique in the Pack and kept across its versions: lower-case letters, digits and dashes"
              },
              "recipe": {
                "type": "object",
                "description": "A ziffr.analysis/1 or ziffr.analysis/2 document, checked by its own schema."
              }
            },
            "required": [
              "key",
              "recipe"
            ],
            "additionalProperties": false
          }
        },
        "themes": {
          "type": "array",
          "maxItems": 50,
          "description": "Themes, each a ziffr.theme/1 or ziffr.theme/2 document under “theme”.",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,39}$",
                "description": "a key unique in the Pack and kept across its versions: lower-case letters, digits and dashes"
              },
              "theme": {
                "type": "object",
                "description": "A ziffr.theme/1 or ziffr.theme/2 document, checked by its own schema."
              }
            },
            "required": [
              "key",
              "theme"
            ],
            "additionalProperties": false
          }
        },
        "decks": {
          "type": "array",
          "maxItems": 50,
          "description": "Deck Templates, each a ziffr.deck-template/1, ziffr.deck-template/2 or ziffr.deck-template/3 document under “template”.",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,39}$",
                "description": "a key unique in the Pack and kept across its versions: lower-case letters, digits and dashes"
              },
              "template": {
                "type": "object",
                "description": "A ziffr.deck-template/1, ziffr.deck-template/2 or ziffr.deck-template/3 document, checked by its own schema."
              }
            },
            "required": [
              "key",
              "template"
            ],
            "additionalProperties": false
          }
        },
        "workflows": {
          "type": "array",
          "maxItems": 50,
          "description": "Workflow Templates, each a ziffr.workflow-template/1 document under “template”.",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,39}$",
                "description": "a key unique in the Pack and kept across its versions: lower-case letters, digits and dashes"
              },
              "template": {
                "type": "object",
                "description": "A ziffr.workflow-template/1 document, checked by its own schema."
              }
            },
            "required": [
              "key",
              "template"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "format",
    "id",
    "name",
    "version",
    "summary",
    "author",
    "license",
    "contents"
  ],
  "additionalProperties": false
}
