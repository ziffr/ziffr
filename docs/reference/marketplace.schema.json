{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ziffr.net/schemas/marketplace.json",
  "title": "Marketplace contract",
  "description": "What a Marketplace answers, what Ziffr sends it, and what it signs (spec 0059). Check an answer against the definition of its kind.",
  "$defs": {
    "packs": {
      "title": "Marketplace: GET v1/packs",
      "description": "The Packs that match a search, newest first; with an empty search, the newest of all.",
      "type": "object",
      "properties": {
        "packs": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 100,
                "pattern": "^[a-z0-9][a-z0-9-]{0,38}/[a-z0-9][a-z0-9-]{0,59}$",
                "description": "the creator's Marketplace handle and a slug, such as “ziffr/saas-metrics”, the same for every version"
              },
              "name": {
                "type": "string",
                "maxLength": 80,
                "pattern": "^(?![\\s\\S]*(?:://|[Ww][Ww][Ww]\\.|[Jj][Aa][Vv][Aa][Ss][Cc][Rr][Ii][Pp][Tt]:|[Dd][Aa][Tt][Aa]:|[Uu][Rr][Ll]\\(|[\\p{L}\\p{N}](?:\\.(?:[Cc][Oo][Mm]|[Nn][Ee][Tt]|[Oo][Rr][Gg]|[Ii][Oo]|[Cc][Oo]|[Ii][Nn][Ff][Oo]|[Bb][Ii][Zz]|[Aa][Pp][Pp]|[Dd][Ee][Vv]|[Xx][Yy][Zz]|[Mm][Ee]|[Aa][Ii]|[Ll][Yy]|[Gg][Ll]|[Gg][Gg]|[Tt][Oo]|[Cc][Cc]|[Tt][Vv]|[Ww][Ss]|[Ll][Ii][Nn][Kk]|[Cc][Ll][Ii][Cc][Kk]|[Ss][Ii][Tt][Ee]|[Oo][Nn][Ll][Ii][Nn][Ee]|[Tt][Oo][Pp]|[Tt][Kk]|[Rr][Uu]|[Cc][Nn]|[Dd][Ee]|[Uu][Kk]|[Ff][Rr]|[Ee][Uu]|[Uu][Ss]|[Nn][Ll]|[Cc][Hh]|[Aa][Tt]|[Ii][Tt]|[Ee][Ss])(?![\\p{L}\\p{N}])|\\.[Xx][Nn]--|\\.\\p{L}{2,}/)|\\b(?:[Hh][Tt][Tt][Pp][Ss]?|[Ff][Tt][Pp]|[Mm][Aa][Ii][Ll][Tt][Oo]|[Tt][Ee][Ll]|[Ss][Mm][Ss]|[Ff][Ii][Ll][Ee]|[Vv][Bb][Ss][Cc][Rr][Ii][Pp][Tt]):(?!\\s)))[\\p{L}\\p{M}\\p{N} .,;:!?'\"’‘“”«»()%€$£¥+\\-–—/&#*=_·…°]*$",
                "description": "plain text, without markup or web addresses",
                "minLength": 1
              },
              "summary": {
                "type": "string",
                "maxLength": 300,
                "pattern": "^(?![\\s\\S]*(?:://|[Ww][Ww][Ww]\\.|[Jj][Aa][Vv][Aa][Ss][Cc][Rr][Ii][Pp][Tt]:|[Dd][Aa][Tt][Aa]:|[Uu][Rr][Ll]\\(|[\\p{L}\\p{N}](?:\\.(?:[Cc][Oo][Mm]|[Nn][Ee][Tt]|[Oo][Rr][Gg]|[Ii][Oo]|[Cc][Oo]|[Ii][Nn][Ff][Oo]|[Bb][Ii][Zz]|[Aa][Pp][Pp]|[Dd][Ee][Vv]|[Xx][Yy][Zz]|[Mm][Ee]|[Aa][Ii]|[Ll][Yy]|[Gg][Ll]|[Gg][Gg]|[Tt][Oo]|[Cc][Cc]|[Tt][Vv]|[Ww][Ss]|[Ll][Ii][Nn][Kk]|[Cc][Ll][Ii][Cc][Kk]|[Ss][Ii][Tt][Ee]|[Oo][Nn][Ll][Ii][Nn][Ee]|[Tt][Oo][Pp]|[Tt][Kk]|[Rr][Uu]|[Cc][Nn]|[Dd][Ee]|[Uu][Kk]|[Ff][Rr]|[Ee][Uu]|[Uu][Ss]|[Nn][Ll]|[Cc][Hh]|[Aa][Tt]|[Ii][Tt]|[Ee][Ss])(?![\\p{L}\\p{N}])|\\.[Xx][Nn]--|\\.\\p{L}{2,}/)|\\b(?:[Hh][Tt][Tt][Pp][Ss]?|[Ff][Tt][Pp]|[Mm][Aa][Ii][Ll][Tt][Oo]|[Tt][Ee][Ll]|[Ss][Mm][Ss]|[Ff][Ii][Ll][Ee]|[Vv][Bb][Ss][Cc][Rr][Ii][Pp][Tt]):(?!\\s)))[\\p{L}\\p{M}\\p{N} .,;:!?'\"’‘“”«»()%€$£¥+\\-–—/&#*=_·…°]*$",
                "description": "plain text, without markup or web addresses"
              },
              "author": {
                "type": "string",
                "maxLength": 80,
                "pattern": "^(?![\\s\\S]*(?:://|[Ww][Ww][Ww]\\.|[Jj][Aa][Vv][Aa][Ss][Cc][Rr][Ii][Pp][Tt]:|[Dd][Aa][Tt][Aa]:|[Uu][Rr][Ll]\\(|[\\p{L}\\p{N}](?:\\.(?:[Cc][Oo][Mm]|[Nn][Ee][Tt]|[Oo][Rr][Gg]|[Ii][Oo]|[Cc][Oo]|[Ii][Nn][Ff][Oo]|[Bb][Ii][Zz]|[Aa][Pp][Pp]|[Dd][Ee][Vv]|[Xx][Yy][Zz]|[Mm][Ee]|[Aa][Ii]|[Ll][Yy]|[Gg][Ll]|[Gg][Gg]|[Tt][Oo]|[Cc][Cc]|[Tt][Vv]|[Ww][Ss]|[Ll][Ii][Nn][Kk]|[Cc][Ll][Ii][Cc][Kk]|[Ss][Ii][Tt][Ee]|[Oo][Nn][Ll][Ii][Nn][Ee]|[Tt][Oo][Pp]|[Tt][Kk]|[Rr][Uu]|[Cc][Nn]|[Dd][Ee]|[Uu][Kk]|[Ff][Rr]|[Ee][Uu]|[Uu][Ss]|[Nn][Ll]|[Cc][Hh]|[Aa][Tt]|[Ii][Tt]|[Ee][Ss])(?![\\p{L}\\p{N}])|\\.[Xx][Nn]--|\\.\\p{L}{2,}/)|\\b(?:[Hh][Tt][Tt][Pp][Ss]?|[Ff][Tt][Pp]|[Mm][Aa][Ii][Ll][Tt][Oo]|[Tt][Ee][Ll]|[Ss][Mm][Ss]|[Ff][Ii][Ll][Ee]|[Vv][Bb][Ss][Cc][Rr][Ii][Pp][Tt]):(?!\\s)))[\\p{L}\\p{M}\\p{N} .,;:!?'\"’‘“”«»()%€$£¥+\\-–—/&#*=_·…°]*$",
                "description": "plain text, without markup or web addresses",
                "minLength": 1
              },
              "license": {
                "enum": [
                  "CC-BY-4.0",
                  "MIT",
                  "Ziffr-Pack-1.0"
                ],
                "description": "Only the free licenses are offered until a Marketplace takes payments."
              },
              "version": {
                "type": "string",
                "maxLength": 20,
                "pattern": "^(?:0|[1-9][0-9]{0,5})\\.(?:0|[1-9][0-9]{0,5})\\.(?:0|[1-9][0-9]{0,5})$",
                "description": "three numbers, major, minor and patch, such as “1.2.0”"
              },
              "newCreator": {
                "type": "boolean",
                "description": "true while the creator is new (spec 0059)."
              }
            },
            "required": [
              "id",
              "name",
              "summary",
              "author",
              "license",
              "version"
            ]
          },
          "description": "Listings; Ziffr reads the first of them and drops one that does not pass."
        }
      },
      "required": [
        "packs"
      ]
    },
    "version": {
      "title": "Marketplace: GET v1/packs/{handle}/{slug}/versions/{version}",
      "description": "One published version: the Pack's text, the statement about it and the statement's signature.",
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "maxLength": 1048576,
          "description": "The Pack file's exact text, at most 1 MiB in UTF-8."
        },
        "statement": {
          "type": "string",
          "maxLength": 4096,
          "description": "the exact text that was signed"
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{86}==$",
          "description": "an Ed25519 signature in base64"
        },
        "revocations": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "properties": {
              "statement": {
                "type": "string",
                "maxLength": 4096,
                "description": "the exact text that was signed"
              },
              "signature": {
                "type": "string",
                "pattern": "^[A-Za-z0-9+/]{86}==$",
                "description": "an Ed25519 signature in base64"
              }
            },
            "required": [
              "statement",
              "signature"
            ]
          },
          "description": "Keys taken out of use, each a ziffr.key-revocation/1 statement signed by the reserve key."
        }
      },
      "required": [
        "file",
        "statement",
        "signature"
      ]
    },
    "updatesRequest": {
      "title": "Marketplace: POST v1/updates (request)",
      "description": "What an Installation sends: Ziffr's version and the Packs it took from the Marketplace, each once, with its oldest installed version. Nothing else.",
      "type": "object",
      "properties": {
        "ziffr": {
          "type": "string",
          "maxLength": 40
        },
        "installed": {
          "type": "array",
          "maxItems": 5000,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 100,
                "pattern": "^[a-z0-9][a-z0-9-]{0,38}/[a-z0-9][a-z0-9-]{0,59}$",
                "description": "the creator's Marketplace handle and a slug, such as “ziffr/saas-metrics”, the same for every version"
              },
              "version": {
                "type": "string",
                "maxLength": 20,
                "pattern": "^(?:0|[1-9][0-9]{0,5})\\.(?:0|[1-9][0-9]{0,5})\\.(?:0|[1-9][0-9]{0,5})$",
                "description": "three numbers, major, minor and patch, such as “1.2.0”"
              }
            },
            "required": [
              "id",
              "version"
            ],
            "additionalProperties": false
          },
          "description": "Packs installed from the Marketplace."
        }
      },
      "required": [
        "ziffr",
        "installed"
      ],
      "additionalProperties": false
    },
    "updates": {
      "title": "Marketplace: POST v1/updates (answer)",
      "description": "Which of the asked Packs have a newer version, and which were withdrawn.",
      "type": "object",
      "properties": {
        "updates": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 100,
                "pattern": "^[a-z0-9][a-z0-9-]{0,38}/[a-z0-9][a-z0-9-]{0,59}$",
                "description": "the creator's Marketplace handle and a slug, such as “ziffr/saas-metrics”, the same for every version"
              },
              "version": {
                "type": "string",
                "maxLength": 20,
                "pattern": "^(?:0|[1-9][0-9]{0,5})\\.(?:0|[1-9][0-9]{0,5})\\.(?:0|[1-9][0-9]{0,5})$",
                "description": "three numbers, major, minor and patch, such as “1.2.0”"
              }
            },
            "required": [
              "id",
              "version"
            ]
          },
          "description": "The newest version of each asked Pack that has a newer one."
        },
        "withdrawals": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "object",
            "properties": {
              "statement": {
                "type": "string",
                "maxLength": 4096,
                "description": "the exact text that was signed"
              },
              "signature": {
                "type": "string",
                "pattern": "^[A-Za-z0-9+/]{86}==$",
                "description": "an Ed25519 signature in base64"
              }
            },
            "required": [
              "statement",
              "signature"
            ]
          },
          "description": "For each asked Pack that was ever withdrawn, its newest ziffr.pack-withdrawal/1 statement, signed: withdrawn, or restored. A Pack left out says nothing about it."
        },
        "revocations": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "properties": {
              "statement": {
                "type": "string",
                "maxLength": 4096,
                "description": "the exact text that was signed"
              },
              "signature": {
                "type": "string",
                "pattern": "^[A-Za-z0-9+/]{86}==$",
                "description": "an Ed25519 signature in base64"
              }
            },
            "required": [
              "statement",
              "signature"
            ]
          },
          "description": "Keys taken out of use, each a ziffr.key-revocation/1 statement signed by the reserve key."
        }
      },
      "required": [
        "updates"
      ]
    },
    "statement": {
      "title": "Marketplace: the signed statement (ziffr.pack-signature/1)",
      "description": "What a Marketplace signs about one file. Ed25519 signs the statement's exact bytes.",
      "type": "object",
      "properties": {
        "format": {
          "const": "ziffr.pack-signature/1"
        },
        "id": {
          "type": "string",
          "maxLength": 100,
          "pattern": "^[a-z0-9][a-z0-9-]{0,38}/[a-z0-9][a-z0-9-]{0,59}$",
          "description": "the creator's Marketplace handle and a slug, such as “ziffr/saas-metrics”, the same for every version"
        },
        "version": {
          "type": "string",
          "maxLength": 20,
          "pattern": "^(?:0|[1-9][0-9]{0,5})\\.(?:0|[1-9][0-9]{0,5})\\.(?:0|[1-9][0-9]{0,5})$",
          "description": "three numbers, major, minor and patch, such as “1.2.0”"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "the SHA-256 of the file's bytes, in hex"
        },
        "key": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$",
          "description": "a key's id: the first 32 hex characters of the SHA-256 of its 32 raw bytes"
        },
        "signed": {
          "type": "string",
          "maxLength": 30,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,3})?Z$",
          "description": "a moment in UTC, such as “2026-11-26T09:00:00Z”"
        },
        "reviewed": {
          "type": "boolean",
          "description": "true only when a moderator looked at this version"
        }
      },
      "required": [
        "format",
        "id",
        "version",
        "sha256",
        "key",
        "signed",
        "reviewed"
      ],
      "additionalProperties": false
    },
    "withdrawal": {
      "title": "Marketplace: a withdrawal (ziffr.pack-withdrawal/1)",
      "description": "That a Pack is withdrawn, or that its withdrawal is taken back. Ed25519 signs the statement's exact bytes. Of two about one Pack, the one with the higher sequence counts.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "const": "withdrawn"
            },
            "format": {
              "const": "ziffr.pack-withdrawal/1"
            },
            "id": {
              "type": "string",
              "maxLength": 100,
              "pattern": "^[a-z0-9][a-z0-9-]{0,38}/[a-z0-9][a-z0-9-]{0,59}$",
              "description": "the creator's Marketplace handle and a slug, such as “ziffr/saas-metrics”, the same for every version"
            },
            "reason": {
              "type": "string",
              "maxLength": 200,
              "pattern": "^(?![\\s\\S]*(?:://|[Ww][Ww][Ww]\\.|[Jj][Aa][Vv][Aa][Ss][Cc][Rr][Ii][Pp][Tt]:|[Dd][Aa][Tt][Aa]:|[Uu][Rr][Ll]\\(|[\\p{L}\\p{N}](?:\\.(?:[Cc][Oo][Mm]|[Nn][Ee][Tt]|[Oo][Rr][Gg]|[Ii][Oo]|[Cc][Oo]|[Ii][Nn][Ff][Oo]|[Bb][Ii][Zz]|[Aa][Pp][Pp]|[Dd][Ee][Vv]|[Xx][Yy][Zz]|[Mm][Ee]|[Aa][Ii]|[Ll][Yy]|[Gg][Ll]|[Gg][Gg]|[Tt][Oo]|[Cc][Cc]|[Tt][Vv]|[Ww][Ss]|[Ll][Ii][Nn][Kk]|[Cc][Ll][Ii][Cc][Kk]|[Ss][Ii][Tt][Ee]|[Oo][Nn][Ll][Ii][Nn][Ee]|[Tt][Oo][Pp]|[Tt][Kk]|[Rr][Uu]|[Cc][Nn]|[Dd][Ee]|[Uu][Kk]|[Ff][Rr]|[Ee][Uu]|[Uu][Ss]|[Nn][Ll]|[Cc][Hh]|[Aa][Tt]|[Ii][Tt]|[Ee][Ss])(?![\\p{L}\\p{N}])|\\.[Xx][Nn]--|\\.\\p{L}{2,}/)|\\b(?:[Hh][Tt][Tt][Pp][Ss]?|[Ff][Tt][Pp]|[Mm][Aa][Ii][Ll][Tt][Oo]|[Tt][Ee][Ll]|[Ss][Mm][Ss]|[Ff][Ii][Ll][Ee]|[Vv][Bb][Ss][Cc][Rr][Ii][Pp][Tt]):(?!\\s)))[\\p{L}\\p{M}\\p{N} .,;:!?'\"’‘“”«»()%€$£¥+\\-–—/&#*=_·…°]*$",
              "description": "Why, in plain words with no web address.",
              "minLength": 1
            },
            "sequence": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991,
              "description": "Higher in every later statement about the same Pack."
            },
            "key": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$",
              "description": "a key's id: the first 32 hex characters of the SHA-256 of its 32 raw bytes"
            },
            "signed": {
              "type": "string",
              "maxLength": 30,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,3})?Z$",
              "description": "a moment in UTC, such as “2026-11-26T09:00:00Z”"
            }
          },
          "required": [
            "state",
            "format",
            "id",
            "reason",
            "sequence",
            "key",
            "signed"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "const": "restored"
            },
            "format": {
              "const": "ziffr.pack-withdrawal/1"
            },
            "id": {
              "type": "string",
              "maxLength": 100,
              "pattern": "^[a-z0-9][a-z0-9-]{0,38}/[a-z0-9][a-z0-9-]{0,59}$",
              "description": "the creator's Marketplace handle and a slug, such as “ziffr/saas-metrics”, the same for every version"
            },
            "sequence": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991,
              "description": "Higher in every later statement about the same Pack."
            },
            "key": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$",
              "description": "a key's id: the first 32 hex characters of the SHA-256 of its 32 raw bytes"
            },
            "signed": {
              "type": "string",
              "maxLength": 30,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,3})?Z$",
              "description": "a moment in UTC, such as “2026-11-26T09:00:00Z”"
            }
          },
          "required": [
            "state",
            "format",
            "id",
            "sequence",
            "key",
            "signed"
          ],
          "additionalProperties": false
        }
      ]
    },
    "revocation": {
      "title": "Marketplace: a key revocation (ziffr.key-revocation/1)",
      "description": "Takes a signing key out of use. Only the reserve key's signature counts.",
      "type": "object",
      "properties": {
        "format": {
          "const": "ziffr.key-revocation/1"
        },
        "key": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$",
          "description": "a key's id: the first 32 hex characters of the SHA-256 of its 32 raw bytes"
        },
        "signed": {
          "type": "string",
          "maxLength": 30,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,3})?Z$",
          "description": "a moment in UTC, such as “2026-11-26T09:00:00Z”"
        }
      },
      "required": [
        "format",
        "key",
        "signed"
      ],
      "additionalProperties": false
    }
  }
}
