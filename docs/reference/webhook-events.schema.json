{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ziffr Webhook message",
  "description": "The JSON body of every message a Ziffr Webhook is sent, by `type`. Action events are `redacted` when the Metric is not shared with Everyone or the Thread is limited to a Group. Signed as described in the Webhooks guide; the same `id` on every retry.",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "id",
        "type",
        "created_at",
        "workspace",
        "data"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^evt_[0-9a-f]{32}$"
        },
        "type": {
          "const": "action.created"
        },
        "created_at": {
          "type": "string"
        },
        "workspace": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "data": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "ref",
                "kind",
                "status",
                "due",
                "assignee",
                "link",
                "updated_at",
                "source",
                "external_ids",
                "title",
                "metric",
                "period",
                "asker"
              ],
              "properties": {
                "ref": {
                  "type": "string",
                  "pattern": "^ZIF-[0-9]+$"
                },
                "kind": {
                  "enum": [
                    "task",
                    "question"
                  ]
                },
                "status": {
                  "enum": [
                    "open",
                    "answered",
                    "closed"
                  ]
                },
                "due": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "assignee": {
                  "type": "object",
                  "required": [
                    "id",
                    "name",
                    "email"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "email": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "additionalProperties": false
                },
                "link": {
                  "type": "string"
                },
                "updated_at": {
                  "type": "string"
                },
                "source": {
                  "type": "object",
                  "required": [
                    "type"
                  ],
                  "properties": {
                    "type": {
                      "enum": [
                        "app",
                        "api",
                        "mcp",
                        "email",
                        "slack",
                        "telegram",
                        "web_form",
                        "ticket_system",
                        "workflow",
                        "system",
                        "webhook"
                      ]
                    },
                    "webhook_id": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                },
                "external_ids": {
                  "type": "array",
                  "maxItems": 10,
                  "items": {
                    "type": "object",
                    "required": [
                      "system",
                      "external_id",
                      "url"
                    ],
                    "properties": {
                      "system": {
                        "type": "string"
                      },
                      "external_id": {
                        "type": "string"
                      },
                      "url": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "reason": {
                  "enum": [
                    "done",
                    "answered",
                    "closed",
                    "metric_archived",
                    "metric_deleted",
                    "assignee_left",
                    "workspace_closing"
