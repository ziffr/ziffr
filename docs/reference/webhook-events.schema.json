                "title": {
                  "type": "string",
                  "maxLength": 200
                },
                "metric": {
                  "type": "object",
                  "required": [
                    "id",
                    "name"
                  ],
                  "properties": {
                    "id": {
                      "type": "integer"
                    },
                    "name": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                },
                "period": {
                  "type": "string"
                },
                "asker": {
                  "type": "object",
