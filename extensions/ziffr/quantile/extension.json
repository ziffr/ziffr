{
  "format": "ziffr.extension/1",
  "id": "ziffr/quantile",
  "version": "1.0.0",
  "kind": "method",
  "name": "Quantile",
  "summary": "The value that a share p of a series' values lie at or below, between its neighbours in proportion.",
  "author": { "name": "Ziffr" },
  "license": "MIT",
  "signature": {
    "inputs": [{ "name": "series", "kind": "series" }],
    "params": [{ "name": "p", "min": 0, "max": 1, "default": 0.5 }],
    "gives": "value"
  },
  "limits": { "points": 120 },
  "ziffr": ">=0.11",
  "price": "free"
}
