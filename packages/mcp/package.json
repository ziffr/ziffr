{
  "name": "@ziffr/mcp",
  "version": "0.1.0",
  "description": "A local MCP server that lets an AI assistant read your Ziffr Metrics and submit values, with an Access Key.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ziffr/ziffr.git",
    "directory": "packages/mcp"
  },
  "type": "module",
  "bin": {
    "ziffr-mcp": "./dist/cli.js"
  },
  "exports": {
    ".": "./src/server.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "test": "vitest run",
    "test:app": "vitest run --config vitest.app.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@ziffr/sdk": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@ziffr/core": "workspace:*",
    "eslint": "^9.39.5",
    "eslint-plugin-jsdoc": "^65.4.5",
    "typescript": "^5",
    "typescript-eslint": "^8.72.2",
    "vitest": "^3.2.4"
  }
}
