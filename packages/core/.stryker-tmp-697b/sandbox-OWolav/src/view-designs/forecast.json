{
  "format": "ziffr.view/1",
  "name": "Forecast",
  "description": "Trend projected a few periods ahead.",
  "kind": "analysis",
  "slots": [{ "label": "Metric", "metrics": "one" }],
  "size": { "w": 6, "h": 7 },
  "options": {
    "window": { "label": "Periods", "default": 18 },
    "showTarget": { "label": "Show target", "default": true },
    "display": { "label": "Show by" }
  },
  "parts": [
    {
      "mark": "text",
      "style": "body",
      "when": ["hasForecast"],
      "content": ["Expected ", { "show": "forecast.value" }, " by ", { "show": "forecast.period" }, " (likely ", { "show": "forecast.low" }, "–", { "show": "forecast.high" }, ")"]
    },
    {
      "mark": "plot",
      "axes": "regular",
      "grid": "horizontal",
      "scale": "padded",
      "marks": [
        { "mark": "band", "show": "target", "when": ["showTarget"] },
        { "mark": "area", "show": "forecast.range", "tone": "data" },
        { "mark": "line", "show": "forecast", "tone": "muted", "dash": true },
        { "mark": "line", "show": "target.line", "tone": "muted", "weight": "light", "when": ["showTarget"] },
        { "mark": "line", "show": "values", "tone": "data", "weight": "strong", "detail": "full" }
      ]
    },
    { "mark": "text", "style": "note", "when": ["showTarget", "hasNote"], "content": [{ "show": "target.note" }] }
  ]
}
