{
  "format": "ziffr.view/1",
  "name": "Number + sparkline",
  "description": "Latest value, change and a small trend.",
  "kind": "metric",
  "slots": [{ "label": "Metric", "metrics": "one" }],
  "size": { "w": 3, "h": 4 },
  "options": { "window": { "label": "Periods", "default": 12 }, "display": { "label": "Show by" } },
  "parts": [
    { "mark": "text", "style": "headline", "content": [{ "show": "latest.value" }] },
    { "mark": "text", "style": "caption", "content": [{ "show": "latest.period" }, { "show": "latest.status" }, { "show": "latest.approval" }] },
    { "mark": "plot", "axes": "none", "scale": "tight", "when": ["manyValues"], "marks": [{ "mark": "line", "show": "values", "tone": "status", "weight": "strong" }] }
  ]
}
