{
  "format": "ziffr.analysis/1",
  "name": "Unusual periods",
  "description": "How far each value lies from the mean, in standard deviations.",
  "slots": [
    {
      "label": "Metric"
    }
  ],
  "steps": [
    {
      "id": "sd",
      "fn": "standardDeviation",
      "of": "slot1"
    },
    {
      "id": "z",
      "fn": "zScore",
      "of": "slot1"
    }
  ],
  "outputs": [
    {
      "step": "z",
      "label": "z-score",
      "unit": "number"
    },
    {
      "step": "sd",
      "label": "Standard deviation",
      "unit": "metric"
    }
  ]
}
