{
  "name": "@ziffr/core",
  "version": "0.11.0",
  "private": true,
  "license": "BUSL-1.1",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:numbers": "NUMBERS_RUNS=${NUMBERS_RUNS:-1000} NUMBERS_SEED=${NUMBERS_SEED:-random} vitest run src/aggregations src/adding-up src/test/reference src/changes src/writing src/derived src/numbers.test src/analyses src/recipe-functions",
    "test:mutation": "NUMBERS_RUNS=${NUMBERS_RUNS:-30} stryker run --incremental --force",
    "lint": "eslint",
    "test:db": "vitest run --config vitest.db.config.ts"
  },
  "devDependencies": {
    "@stryker-mutator/api": "10.1.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@vitest/coverage-v8": "4.1.12",
    "ajv": "8.20.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsdoc": "^65.4.5",
    "fast-check": "^4.10.2",
    "typescript": "^5",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "@ziffr/figures": "workspace:*",
    "@ziffr/pack": "workspace:*",
    "date-fns": "^4.4.0",
    "nodemailer": "^10.5.0",
    "postal-mime": "^4.2.1"
  }
}
