{
  "format": "ziffr.view/1",
  "name": "Gauge vs. target",
  "description": "Where the latest value sits against the target.",
  "kind": "metric",
  "slots": [{ "label": "Metric", "metrics": "one" }],
  "size": { "w": 3, "h": 4 },
  "options": { "window": { "label": "Periods its scale covers", "default": 12 } },
  "parts": [
    {
      "mark": "group",
      "direction": "column",
      "align": "center",
      "parts": [
        { "mark": "gauge", "show": "latest" },
        { "mark": "text", "style": "value", "content": [{ "show": "latest.value" }] },
        { "mark": "text", "style": "body", "content": [{ "show": "latest.status" }] }
      ]
    }
  ]
}
