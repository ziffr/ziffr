{
  "format": "ziffr.view/1",
  "name": "Line chart",
  "description": "Trend with target band and optional forecast.",
  "kind": "metric",
  "slots": [{ "label": "Metric", "metrics": "one" }],
  "size": { "w": 6, "h": 6 },
  "options": {
    "window": { "label": "Periods", "default": 12 },
    "showTarget": { "label": "Show target", "default": true },
    "showForecast": { "label": "Show forecast", "default": false },
    "display": { "label": "Show by" }
  },
  "parts": [
    {
      "mark": "plot",
      "axes": "regular",
      "grid": "horizontal",
      "scale": "padded",
      "marks": [
        { "mark": "band", "show": "target", "when": ["showTarget"] },
        { "mark": "area", "show": "forecast.range", "tone": "data", "when": ["showForecast"] },
        { "mark": "line", "show": "forecast", "tone": "muted", "dash": true, "when": ["showForecast"] },
        { "mark": "line", "show": "target.line", "tone": "muted", "weight": "light", "when": ["showTarget"] },
        { "mark": "line", "show": "values", "tone": "data", "weight": "strong", "detail": "full" }
      ]
    },
    { "mark": "text", "style": "note", "when": ["showTarget", "hasNote"], "content": [{ "show": "target.note" }] }
  ]
}
