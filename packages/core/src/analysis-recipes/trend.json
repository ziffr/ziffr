{
  "format": "ziffr.analysis/1",
  "name": "Linear trend",
  "description": "The straight line that fits the values best, and how much it rises each period.",
  "slots": [
    {
      "label": "Metric"
    }
  ],
  "steps": [
    {
      "id": "line",
      "fn": "linearTrend",
      "of": "slot1"
    },
    {
      "id": "slope",
      "fn": "slope",
      "of": "slot1"
    }
  ],
  "outputs": [
    {
      "step": "line",
      "label": "Trend",
      "unit": "metric"
    },
    {
      "step": "slope",
      "label": "Rise per period",
      "unit": "metric"
    }
  ]
}
