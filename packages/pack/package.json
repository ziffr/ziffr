{
  "name": "@ziffr/pack",
  "version": "0.1.0",
  "description": "Write and check a Ziffr Pack: Metric Catalog entries, templates, View Designs, Analysis Recipes and Themes as one file, with no code.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ziffr/ziffr.git",
    "directory": "packages/pack"
  },
  "type": "module",
  "bin": {
    "ziffr-pack": "./dist/cli.js"
  },
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "publishConfig": {
    "access": "public",
    "bin": {
      "ziffr-pack": "./dist/cli.js"
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./*": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^20",
    "eslint": "^9.39.5",
    "eslint-plugin-jsdoc": "^65.4.5",
    "typescript": "^5",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.1.12"
  }
}
