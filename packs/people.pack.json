{
  "format": "ziffr.pack/3",
  "id": "ziffr/people",
  "name": "People and HR",
  "version": "1.5.0",
  "summary": "Headcount, hires, leavers, open roles, time to hire, absence and engagement, with attrition worked out, a monthly dashboard and a Workflow that asks HR for the month's figures.",
  "author": {
    "name": "Ziffr"
  },
  "license": "CC-BY-4.0",
  "ziffr": ">=0.21",
  "audience": {
    "functions": [
      "people"
    ]
  },
  "listing": {
    "homepage": "https://github.com/ziffr/ziffr/tree/main/packs"
  },
  "setUp": {
    "line": "Your team in numbers: who joined, who left and how people are.",
    "happens": [
      "The month's people figures are asked for",
      "Engagement is asked for once a quarter",
      "The dashboard fills in and works out attrition"
    ],
    "needs": [
      "Headcount, hires, leavers and open roles",
      "Time to hire, absence rate and engagement score"
    ]
  },
  "guide": {
    "whatItsFor": [
      {
        "type": "text",
        "text": "For whoever looks after people and HR. The team's figures come in monthly, engagement once a quarter. A dashboard shows who joined and left, attrition, open roles, time to hire, absence and engagement."
      }
    ],
    "beforeYouStart": [
      {
        "type": "list",
        "items": [
          "Monthly: headcount, hires, leavers, open roles, time to hire and absence rate.",
          "Quarterly: the engagement score.",
          "Room for 8 Metrics in your Workspace."
        ]
      }
    ],
    "questions": [
      {
        "type": "heading",
        "text": "Who sees the figures?"
      },
      {
        "type": "text",
        "text": "A Metric's owner, whoever sends its values and those it is shared with, also through a dashboard. Figures about people are sensitive, so share them with care."
      }
    ]
  },
  "contents": {
    "metrics": [
      {
        "key": "headcount",
        "comesFrom": { "by": "person" },
        "metric": {
          "format": "ziffr.metric/2",
          "name": "Headcount",
          "description": "People employed at month end, counted as people, not full-time equivalents.",
          "calculationNote": "Employees with a contract on the last day of the month, each counted as one whatever their hours. Freelancers and agency staff are not counted.",
          "category": "People",
          "period": "month",
          "aggregation": "last",
          "polarity": "target",
          "valueFormat": "number",
          "decimals": 0,
          "submissionRule": "overwrite",
          "sources": [
            "web_form",
            "mail",
            "slack",
            "telegram",
            "api"
          ],
          "tags": [
            "People",
            "Monthly report",
            "Board"
          ]
        }
      },
      {
        "key": "hires",
        "comesFrom": { "by": "person" },
        "metric": {
          "format": "ziffr.metric/2",
          "name": "Hires",
          "description": "People who started in the month.",
          "calculationNote": "Employees whose first working day lies in the month. A signed contract that starts later is counted when it starts.",
          "category": "People",
          "period": "month",
          "aggregation": "sum",
          "polarity": "higher",
          "valueFormat": "number",
          "decimals": 0,
          "submissionRule": "overwrite",
          "sources": [
            "web_form",
            "mail",
            "slack",
            "telegram",
            "api"
          ],
          "tags": [
            "People"
          ]
        }
      },
      {
        "key": "leavers",
        "comesFrom": { "by": "person" },
        "metric": {
          "format": "ziffr.metric/2",
          "name": "Leavers",
          "description": "People who left in the month, whatever the reason.",
          "calculationNote": "Employees whose last day of employment lies in the month, whether they resigned, were let go, retired or reached the end of a contract.",
          "category": "People",
          "period": "month",
          "aggregation": "sum",
          "polarity": "lower",
          "valueFormat": "number",
          "decimals": 0,
          "submissionRule": "overwrite",
          "sources": [
            "web_form",
            "mail",
            "slack",
            "telegram",
            "api"
          ],
          "tags": [
            "People",
            "Monthly report"
          ]
        }
      },
      {
        "key": "open-roles",
        "comesFrom": { "by": "person" },
        "metric": {
          "format": "ziffr.metric/2",
          "name": "Open roles",
          "description": "Positions being recruited for at month end.",
          "calculationNote": "Approved positions without an accepted offer on the last day of the month. Two people sought for the same job count as two.",
          "category": "People",
          "period": "month",
          "aggregation": "last",
          "polarity": "lower",
          "valueFormat": "number",
          "decimals": 0,
          "submissionRule": "overwrite",
          "sources": [
            "web_form",
            "mail",
            "slack",
            "telegram",
            "api"
          ],
          "tags": [
            "People"
          ]
        }
      },
      {
        "key": "time-to-hire",
        "comesFrom": { "by": "person" },
        "metric": {
          "format": "ziffr.metric/2",
          "name": "Time to hire",
          "description": "The average days from opening a role to the accepted offer, for the roles filled in the month.",
          "calculationNote": "Calendar days from the day a role was opened to the day its offer was accepted, averaged over the roles filled in the month.",
          "category": "People",
          "period": "month",
          "aggregation": "average",
          "polarity": "lower",
          "unit": "days",
          "unitPosition": "after",
          "valueFormat": "number",
          "decimals": 0,
          "submissionRule": "overwrite",
          "sources": [
            "web_form",
            "mail",
            "slack",
            "telegram",
            "api"
          ],
          "tags": [
            "People"
          ]
        }
      },
      {
        "key": "absence-rate",
        "comesFrom": { "by": "person" },
        "metric": {
          "format": "ziffr.metric/2",
          "name": "Absence rate",
          "description": "Days of sickness absence as a share of the working days in the month.",
          "calculationNote": "Working days lost to sickness divided by the working days employees were due to work in the month, in percent. Holidays and parental leave are not sickness.",
          "category": "People",
          "period": "month",
          "aggregation": "average",
          "polarity": "lower",
          "unit": "%",
          "unitPosition": "after",
          "valueFormat": "percent",
          "decimals": 1,
          "submissionRule": "overwrite",
          "targetMax": 4,
          "sources": [
            "web_form",
            "mail",
            "slack",
            "telegram",
            "api"
          ],
          "tags": [
            "People",
            "Monthly report"
          ]
        }
      },
      {
        "key": "engagement",
        "comesFrom": { "by": "person" },
        "metric": {
          "format": "ziffr.metric/2",
          "name": "Engagement score",
          "description": "The average answer to the engagement question in the latest survey, 0 to 100.",
          "calculationNote": "The average of all answers to the engagement question in the latest survey of the quarter, on a scale of 0 to 100. People who did not answer are left out.",
          "category": "People",
          "period": "quarter",
          "aggregation": "last",
          "polarity": "higher",
          "valueFormat": "number",
          "decimals": 0,
          "submissionRule": "overwrite",
          "sources": [
            "web_form",
            "mail",
            "slack",
            "telegram",
            "api"
          ],
          "tags": [
            "People",
            "Board"
          ]
        }
      },
      {
        "key": "attrition-rate",
        "metric": {
          "format": "ziffr.metric/2",
          "name": "Attrition rate",
          "description": "People who left in the month as a share of the headcount at month end.",
          "calculationNote": "Leavers of the month divided by the headcount at its end, in percent. It is a monthly rate, not scaled to a year.",
          "category": "People",
          "period": "month",
          "aggregation": "none",
          "polarity": "lower",
          "unit": "%",
          "unitPosition": "after",
          "valueFormat": "percent",
          "decimals": 1,
          "formula": "{leavers} / {headcount} * 100",
          "tags": [
            "People",
            "Monthly report",
            "Board"
          ]
        }
      }
    ],
    "dashboards": [
      {
        "key": "people-monthly",
        "template": {
          "format": "ziffr.dashboard-template/1",
          "name": "People monthly",
          "description": "The size of the team, who joined and left, how many go, and how many are absent.",
          "slots": [
            {
              "label": "Headcount",
              "suggests": "headcount"
            },
            {
              "label": "Hires",
              "suggests": "hires"
            },
            {
              "label": "Leavers",
              "suggests": "leavers"
            },
            {
              "label": "Attrition rate",
              "suggests": "attrition-rate"
            },
            {
              "label": "Absence rate",
              "suggests": "absence-rate"
            },
            {
              "label": "Open roles",
              "suggests": "open-roles"
            }
          ],
          "widgets": [
            {
              "view": "number",
              "slots": [
                0
              ],
              "x": 0,
              "y": 0,
              "w": 3,
              "h": 4
            },
            {
              "view": "number",
              "slots": [
                1
              ],
              "x": 3,
              "y": 0,
              "w": 3,
              "h": 4
            },
            {
              "view": "number",
              "slots": [
                2
              ],
              "x": 6,
              "y": 0,
              "w": 3,
              "h": 4
            },
            {
              "view": "number",
              "slots": [
                3
              ],
              "x": 9,
              "y": 0,
              "w": 3,
              "h": 4
            },
            {
              "view": "line",
              "slots": [
                0
              ],
              "x": 0,
              "y": 4,
              "w": 6,
              "h": 6,
              "settings": {
                "window": 12
              }
            },
            {
              "view": "gauge",
              "slots": [
                4
              ],
              "x": 6,
              "y": 4,
              "w": 3,
              "h": 6
            },
            {
              "view": "number",
              "slots": [
                5
              ],
              "x": 9,
              "y": 4,
              "w": 3,
              "h": 6
            },
            {
              "view": "bars",
              "slots": [
                2
              ],
              "x": 0,
              "y": 10,
              "w": 12,
              "h": 6,
              "settings": {
                "window": 12
              }
            }
          ]
        }
      }
    ],
    "workflows": [
      {
        "key": "monthly-people-figures",
        "template": {
          "format": "ziffr.workflow-template/1",
          "name": "Monthly people figures",
          "description": "The month's people figures are asked for on the third working day after the month, and published.",
          "dueWorkingDays": 3,
          "steps": [
            {
              "type": "remind",
              "daysBefore": 1
            },
            {
              "type": "escalate",
              "to": "owner",
              "daysAfter": 1
            },
            {
              "type": "check",
              "changePct": 25,
              "outsideTarget": true
            },
            {
              "type": "publish",
              "lock": false
            }
          ]
        }
      }
    ]
  },
  "feeds": [
    {
      "template": "excel",
      "fills": [
        "headcount",
        "hires",
        "leavers",
        "open-roles"
      ]
    },
    {
      "template": "google-sheets",
      "fills": [
        "absence-rate",
        "time-to-hire"
      ]
    }
  ]
}
