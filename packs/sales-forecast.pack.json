{
  "format": "ziffr.pack/1",
  "id": "ziffr/sales-forecast",
  "name": "Sales forecast",
  "version": "1.0.0",
  "summary": "A weekly sales forecast: commit, best case, closed this quarter, pipeline and quota, with the gap to quota and pipeline coverage worked out, a dashboard and a deck for the weekly meeting and a Workflow that asks on Monday and has the sales lead approve.",
  "author": {
    "name": "Ziffr"
  },
  "license": "CC-BY-4.0",
  "ziffr": ">=0.11",
  "audience": {
    "functions": [
      "sales"
    ]
  },
  "listing": {
    "homepage": "https://github.com/ziffr/ziffr/tree/main/packs"
  },
  "contents": {
    "metrics": [
      {
        "key": "commit",
        "metric": {
          "format": "ziffr.metric/1",
          "name": "Commit",
          "description": "The forecast call: what the team commits to closing by the end of the quarter, deals already won in it included. Taken as it stood at the end of the week: an answer to Monday's request, by reply or form link, counts for the week just ended. By salesperson: add a breakdown with one line for each person, and leave the value empty to add the lines up.",
          "category": "Sales",
          "period": "week",
          "aggregation": "last",
          "polarity": "higher",
          "unit": "€",
          "unitPosition": "after",
          "valueFormat": "currency",
          "decimals": 0,
          "submissionRule": "overwrite",
          "sources": [
            "web_form",
            "mail",
            "slack",
            "telegram",
            "api"
          ],
          "tags": [
            "Sales",
            "Sales forecast"
          ]
        }
      },
      {
        "key": "best-case",
        "metric": {
          "format": "ziffr.metric/1",
          "name": "Best case",
          "description": "What the quarter reaches if the open deals that may still close do: commit plus upside, deals already won included. Taken as it stood at the end of the week: an answer to Monday's request, by reply or form link, counts for the week just ended. By salesperson: add a breakdown with one line for each person, and leave the value empty to add the lines up.",
          "category": "Sales",
          "period": "week",
          "aggregation": "last",
          "polarity": "higher",
          "unit": "€",
          "unitPosition": "after",
          "valueFormat": "currency",
          "decimals": 0,
          "submissionRule": "overwrite",
          "sources": [
            "web_form",
            "mail",
            "slack",
            "telegram",
            "api"
          ],
          "tags": [
            "Sales",
            "Sales forecast"
          ]
        }
      },
      {
        "key": "closed-quarter",
        "metric": {
          "format": "ziffr.metric/1",
          "name": "Closed this quarter",
          "description": "The value of the deals won since the quarter began. It starts again from 0 each quarter; a week that spans two quarters belongs to the one it starts in. Taken as it stood at the end of the week: an answer to Monday's request, by reply or form link, counts for the week just ended. By salesperson: add a breakdown with one line for each person, and leave the value empty to add the lines up.",
          "category": "Sales",
          "period": "week",
          "aggregation": "last",
          "polarity": "higher",
          "unit": "€",
          "unitPosition": "after",
          "valueFormat": "currency",
          "decimals": 0,
          "submissionRule": "overwrite",
          "sources": [
            "web_form",
            "mail",
            "slack",
            "telegram",
            "api"
          ],
          "tags": [
            "Sales",
            "Sales forecast"
          ]
        }
      },
      {
        "key": "pipeline",
        "metric": {
          "format": "ziffr.metric/1",
          "name": "Pipeline value",
          "description": "The value of all open deals that can still close this quarter, those in the commit included, those already won not. Taken as it stood at the end of the week: an answer to Monday's request, by reply or form link, counts for the week just ended. By salesperson: add a breakdown with one line for each person, and leave the value empty to add the lines up.",
          "category": "Sales",
          "period": "week",
          "aggregation": "last",
          "polarity": "higher",
          "unit": "€",
          "unitPosition": "after",
          "valueFormat": "currency",
          "decimals": 0,
          "submissionRule": "overwrite",
          "sources": [
            "web_form",
            "mail",
            "slack",
            "telegram",
            "api"
          ],
          "tags": [
            "Sales",
            "Sales forecast"
          ]
        }
      },
      {
        "key": "quota",
        "metric": {
          "format": "ziffr.metric/1",
          "name": "Quota",
          "description": "The team's quota for the whole quarter, not a weekly share. Send it every week, unchanged until it changes: without it, that week has no gap and no coverage. Taken as it stood at the end of the week: an answer to Monday's request, by reply or form link, counts for the week just ended.",
          "category": "Sales",
          "period": "week",
          "aggregation": "last",
          "polarity": "higher",
          "unit": "€",
          "unitPosition": "after",
          "valueFormat": "currency",
          "decimals": 0,
          "submissionRule": "overwrite",
          "sources": [
            "web_form",
            "mail",
            "slack",
            "telegram",
            "api"
          ],
          "tags": [
            "Sales",
            "Sales forecast"
          ]
        }
      },
      {
        "key": "commit-gap",
        "metric": {
          "format": "ziffr.metric/1",
          "name": "Commit gap to quota",
          "description": "Commit minus Quota for the week. Below 0, the commit is that much short of the quota; 0 or more covers it. Empty until both have a value.",
          "category": "Sales",
          "period": "week",
          "aggregation": "none",
          "polarity": "higher",
          "unit": "€",
          "unitPosition": "after",
          "valueFormat": "currency",
          "decimals": 0,
          "targetMin": 0,
          "formula": "{commit} - {quota}",
          "tags": [
            "Sales",
            "Sales forecast"
          ]
        }
      },
      {
        "key": "commit-share",
        "metric": {
          "format": "ziffr.metric/1",
          "name": "Commit as share of quota",
          "description": "Commit as a share of Quota for the same week. 100 % or more covers the quota. Empty until both have a value, and when the quota is 0.",
          "category": "Sales",
          "period": "week",
          "aggregation": "none",
          "polarity": "higher",
          "unit": "%",
          "unitPosition": "after",
          "valueFormat": "percent",
          "decimals": 0,
          "targetMin": 100,
          "formula": "{commit} / {quota} * 100",
          "tags": [
            "Sales",
            "Sales forecast"
          ]
        }
      },
      {
        "key": "coverage",
        "metric": {
          "format": "ziffr.metric/1",
          "name": "Pipeline coverage",
          "description": "Pipeline value divided by what is still missing, which is Quota minus Closed this quarter. 3 times means the open deals are worth three times what is missing. Empty when a figure is missing or exactly nothing is left to close. Below 0 when more than the quota is closed: then nothing is left to cover.",
          "category": "Sales",
          "period": "week",
          "aggregation": "none",
          "polarity": "higher",
          "unit": "times",
          "unitPosition": "after",
          "valueFormat": "number",
          "decimals": 1,
          "formula": "{pipeline} / ({quota} - {closed-quarter})",
          "tags": [
            "Sales",
            "Sales forecast"
          ]
        }
      }
    ],
