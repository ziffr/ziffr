    "workflows": [
      {
        "key": "weekly-forecast",
        "template": {
          "format": "ziffr.workflow-template/1",
          "name": "Weekly sales forecast",
          "description": "Asks on Monday for the week just ended, due Tuesday with a reminder, then tells the Metric Owner. The sales lead approves every value, which publishes and locks. Add a Send Snapshot step to send the dashboard once the week is finished.",
          "dueWorkingDays": 2,
          "steps": [
            {
              "type": "remind",
              "daysBefore": 0
            },
            {
              "type": "escalate",
              "to": "owner",
              "daysAfter": 0
            },
            {
              "type": "check",
              "changePct": 25,
              "outsideTarget": false
            },
            {
              "type": "approve",
              "approvers": 1,
              "values": "every",
              "nobodyElse": "self-check"
            },
            {
              "type": "publish",
              "lock": true
            }
          ]
        }
      }
    ]
  },
