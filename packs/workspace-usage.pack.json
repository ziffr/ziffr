    "dashboards": [
      {
        "key": "workspace-usage",
        "template": {
          "format": "ziffr.dashboard-template/1",
          "name": "Workspace usage",
          "description": "How this Workspace is used: what is looked at, what arrives by which Source, and what goes unused.",
          "slots": [
            {
              "label": "Views: dashboards",
              "suggests": "workspace-views-dashboards"
            },
            {
              "label": "Views: metrics",
              "suggests": "workspace-views-metrics"
            },
            {
              "label": "Values",
              "suggests": "workspace-values"
            },
            {
              "label": "Metrics",
              "suggests": "workspace-metrics"
            },
            {
              "label": "Metrics without values",
              "suggests": "workspace-metrics-without-values"
            },
            {
              "label": "Metrics not opened",
              "suggests": "workspace-metrics-not-opened"
            },
            {
              "label": "Dashboards not opened",
              "suggests": "workspace-dashboards-not-opened"
            },
            {
              "label": "Archive suggestions",
              "suggests": "workspace-archive-suggestions"
            }
          ],
          "widgets": [
