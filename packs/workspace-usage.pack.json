{
  "format": "ziffr.pack/1",
  "id": "ziffr/workspace-usage",
  "name": "Workspace usage",
  "version": "1.0.0",
  "summary": "Your own Workspace's usage as Metrics, with a dashboard: views of dashboards, decks and Metrics, values by Source, and what goes unused. Counts only, never who looked. For Owners and Admins.",
  "author": {
    "name": "Ziffr"
  },
  "license": "CC-BY-4.0",
  "ziffr": ">=0.11",
  "listing": {
    "homepage": "https://github.com/ziffr/ziffr/tree/main/packs"
  },
  "contents": {
    "metrics": [
      {
        "key": "workspace-metrics",
        "metric": {
          "format": "ziffr.metric/1",
          "name": "Workspace: metrics",
          "description": "Metrics in use in this Workspace, as of the run. Archived Metrics are not counted.",
          "category": "Workspace usage",
          "period": "day",
          "aggregation": "last",
          "polarity": "target",
          "unit": "Metrics",
          "unitPosition": "after",
          "valueFormat": "number",
          "decimals": 0,
          "submissionRule": "overwrite",
          "sources": [
            "api"
          ]
        }
      },
      {
        "key": "workspace-metrics-without-values",
        "metric": {
          "format": "ziffr.metric/1",
          "name": "Workspace: metrics without values",
          "description": "Metrics with no value for 90 days (or the last two periods of their cadence), as of the run.",
          "category": "Workspace usage",
          "period": "day",
          "aggregation": "last",
          "polarity": "lower",
          "unit": "Metrics",
          "unitPosition": "after",
          "valueFormat": "number",
          "decimals": 0,
          "submissionRule": "overwrite",
          "sources": [
            "api"
          ]
        }
      },
      {
        "key": "workspace-metrics-not-opened",
        "metric": {
          "format": "ziffr.metric/1",
          "name": "Workspace: metrics not opened",
          "description": "Metrics nobody opened for 90 days, as of the run. Held back until 90 days were counted.",
          "category": "Workspace usage",
          "period": "day",
          "aggregation": "last",
          "polarity": "lower",
          "unit": "Metrics",
          "unitPosition": "after",
          "valueFormat": "number",
          "decimals": 0,
          "submissionRule": "overwrite",
          "sources": [
            "api"
          ]
        }
      },
      {
        "key": "workspace-dashboards-not-opened",
        "metric": {
          "format": "ziffr.metric/1",
          "name": "Workspace: dashboards not opened",
          "description": "Dashboards not opened for 90 days, as of the run. Held back until 90 days were counted.",
          "category": "Workspace usage",
          "period": "day",
          "aggregation": "last",
          "polarity": "lower",
          "unit": "dashboards",
          "unitPosition": "after",
          "valueFormat": "number",
          "decimals": 0,
          "submissionRule": "overwrite",
          "sources": [
            "api"
          ]
        }
      },
      {
        "key": "workspace-decks-not-opened",
        "metric": {
          "format": "ziffr.metric/1",
          "name": "Workspace: decks not opened",
          "description": "Decks not opened for 90 days, as of the run. Held back until 90 days were counted.",
          "category": "Workspace usage",
          "period": "day",
          "aggregation": "last",
          "polarity": "lower",
          "unit": "decks",
          "unitPosition": "after",
          "valueFormat": "number",
          "decimals": 0,
          "submissionRule": "overwrite",
          "sources": [
            "api"
          ]
        }
      },
      {
        "key": "workspace-submitters-without-values",
        "metric": {
          "format": "ziffr.metric/1",
          "name": "Workspace: submitters without values",
          "description": "Submitters who recorded no value for 90 days, as of the run: a number, never a name. Held back while fewer than three people are in the Workspace.",
          "category": "Workspace usage",
          "period": "day",
          "aggregation": "last",
          "polarity": "lower",
          "unit": "Submitters",
          "unitPosition": "after",
          "valueFormat": "number",
          "decimals": 0,
          "submissionRule": "overwrite",
          "sources": [
            "api"
          ]
        }
