        }
      },
      {
        "key": "workspace-values",
        "metric": {
          "format": "ziffr.metric/1",
          "name": "Workspace: values",
          "description": "Values recorded in the day, by any Source. Only the Metrics the program's key may see; held back while fewer than three people are in the Workspace.",
          "category": "Workspace usage",
          "period": "day",
          "aggregation": "sum",
          "polarity": "higher",
          "unit": "values",
          "unitPosition": "after",
          "valueFormat": "number",
