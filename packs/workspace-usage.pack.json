          "category": "Workspace usage",
          "period": "day",
          "aggregation": "last",
          "polarity": "lower",
          "unit": "Metrics",
          "unitPosition": "after",
          "valueFormat": "number",
          "decimals": 0,
          "submissionRule": "overwrite",
          "sources": [
