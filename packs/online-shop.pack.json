{
  "format": "ziffr.pack/1",
  "id": "ziffr/online-shop",
  "name": "Online shop",
  "version": "1.2.0",
  "summary": "Orders, revenue by channel, average order value, conversion, returns and sessions, with a weekly dashboard and a Workflow that asks for the week's numbers on Monday.",
  "author": {
    "name": "Ziffr"
  },
  "license": "CC-BY-4.0",
  "ziffr": ">=0.11",
  "audience": {
    "industries": [
      "ecommerce",
      "retail"
    ],
    "segments": [
      "b2c"
    ]
  },
  "listing": {
    "homepage": "https://github.com/ziffr/ziffr/tree/main/packs"
  },
  "contents": {
    "metrics": [
      {
        "key": "orders",
        "metric": {
          "format": "ziffr.metric/2",
          "name": "Orders",
          "description": "Orders placed in the week, including those later cancelled or returned.",
          "calculationNote": "Orders placed from Monday to Sunday, counted on the day of the order, including those later cancelled or returned. Test orders are left out.",
          "category": "E-commerce",
          "industries": [
            "ecommerce",
            "retail"
          ],
          "period": "week",
          "aggregation": "sum",
          "polarity": "higher",
          "unit": "orders",
          "unitPosition": "after",
          "valueFormat": "number",
          "decimals": 0,
          "submissionRule": "overwrite",
          "sources": [
            "web_form",
            "mail",
            "slack",
            "telegram",
            "api"
          ]
        }
      },
      {
        "key": "revenue",
        "metric": {
          "format": "ziffr.metric/2",
          "name": "Online revenue",
          "description": "Revenue from online orders in the week, excluding VAT and shipping fees, before returns. Record it with a Breakdown by channel to see where it comes from.",
          "calculationNote": "What customers ordered from Monday to Sunday, after discounts and vouchers. VAT and shipping fees are left out, and later returns are not taken off.",
          "category": "E-commerce",
          "industries": [
            "ecommerce",
            "retail"
          ],
          "period": "week",
          "aggregation": "sum",
          "polarity": "higher",
          "unit": "€",
          "unitPosition": "after",
          "valueFormat": "currency",
          "decimals": 0,
          "submissionRule": "overwrite",
          "sources": [
            "web_form",
            "mail",
            "slack",
            "telegram",
            "api"
          ]
        }
      },
      {
        "key": "aov",
        "metric": {
          "format": "ziffr.metric/2",
          "name": "Average order value",
          "description": "Online revenue divided by the number of orders, in the week.",
          "calculationNote": "Online revenue of the week divided by its number of orders. VAT and shipping fees are not in it, because they are not in the revenue.",
          "category": "E-commerce",
          "period": "week",
          "aggregation": "none",
          "polarity": "higher",
          "unit": "€",
          "unitPosition": "after",
          "valueFormat": "currency",
          "decimals": 2,
          "submissionRule": "overwrite",
          "formula": "{revenue} / {orders}"
        }
      },
      {
        "key": "conversion",
        "metric": {
          "format": "ziffr.metric/2",
          "name": "Conversion rate",
          "description": "Share of website visitors who placed an order.",
          "calculationNote": "Orders placed in the week divided by visits to the shop in the same week, in percent. A person who visits twice counts as two visits.",
          "category": "E-commerce",
          "industries": [
            "ecommerce"
          ],
          "period": "week",
          "aggregation": "none",
          "polarity": "higher",
          "unit": "%",
          "unitPosition": "after",
          "valueFormat": "percent",
          "decimals": 2,
          "submissionRule": "overwrite",
          "targetMin": 2.5,
          "sources": [
            "web_form",
            "mail",
            "slack",
            "telegram",
            "api"
          ]
        }
      },
      {
        "key": "return-rate",
        "metric": {
          "format": "ziffr.metric/2",
          "name": "Return rate",
          "description": "Items returned as a share of items sold, by the week of sale.",
          "calculationNote": "Items sent back divided by items sold, in percent, counted in the week the item was sold. The figure of a recent week can still rise.",
          "category": "E-commerce",
          "industries": [
            "ecommerce",
            "retail"
          ],
          "period": "week",
          "aggregation": "none",
          "polarity": "lower",
          "unit": "%",
          "unitPosition": "after",
          "valueFormat": "percent",
          "decimals": 1,
          "submissionRule": "overwrite",
          "sources": [
            "web_form",
            "mail",
            "slack",
            "telegram",
            "api"
          ]
        }
      },
      {
        "key": "sessions",
        "metric": {
          "format": "ziffr.metric/2",
          "name": "Sessions",
          "description": "Visits to the online shop in the week; one person can have several.",
          "calculationNote": "Visits counted by your web analytics from Monday to Sunday. One person visiting twice counts twice, and known bots are left out.",
          "category": "E-commerce",
          "industries": [
            "ecommerce"
          ],
          "period": "week",
          "aggregation": "sum",
          "polarity": "higher",
          "unit": "sessions",
          "unitPosition": "after",
          "valueFormat": "number",
          "decimals": 0,
          "submissionRule": "overwrite",
          "sources": [
            "web_form",
            "mail",
            "slack",
            "telegram",
            "api"
          ]
        }
      }
    ],
    "dashboards": [
      {
        "key": "shop-weekly",
        "template": {
          "format": "ziffr.dashboard-template/1",
          "name": "Shop weekly",
          "description": "Orders, revenue and where it comes from, conversion and returns, week by week.",
          "slots": [
            {
              "label": "Online revenue",
              "suggests": "revenue"
            },
            {
              "label": "Orders",
              "suggests": "orders"
            },
            {
              "label": "Average order value",
              "suggests": "aov"
            },
            {
              "label": "Conversion rate",
              "suggests": "conversion"
            },
            {
              "label": "Return rate",
              "suggests": "return-rate"
            },
            {
              "label": "Sessions",
              "suggests": "sessions"
            }
          ],
          "widgets": [
            {
              "view": "number",
              "slots": [
                0
              ],
              "x": 0,
              "y": 0,
              "w": 3,
              "h": 4
            },
            {
              "view": "number",
              "slots": [
                1
              ],
              "x": 3,
              "y": 0,
              "w": 3,
              "h": 4
            },
            {
              "view": "number",
              "slots": [
                2
              ],
              "x": 6,
              "y": 0,
              "w": 3,
              "h": 4
            },
            {
              "view": "number",
              "slots": [
                3
              ],
              "x": 9,
              "y": 0,
              "w": 3,
              "h": 4
            },
            {
              "view": "line",
              "slots": [
                0
              ],
              "x": 0,
              "y": 4,
              "w": 8,
              "h": 6,
              "settings": {
                "window": 13,
                "showTarget": true
              }
            },
            {
              "view": "share",
              "slots": [
                0
              ],
              "x": 8,
              "y": 4,
              "w": 4,
              "h": 6
            },
            {
              "view": "bars",
              "slots": [
                5
              ],
              "x": 0,
              "y": 10,
              "w": 6,
              "h": 6,
              "settings": {
                "window": 13
              }
            },
            {
              "view": "line",
              "slots": [
                4
              ],
              "x": 6,
              "y": 10,
              "w": 6,
              "h": 6,
              "settings": {
                "window": 13,
                "showTarget": true
              }
            }
          ]
        }
      }
    ],
    "workflows": [
      {
        "key": "monday-numbers",
        "template": {
          "format": "ziffr.workflow-template/1",
          "name": "Monday numbers",
          "description": "The week's numbers are due on Monday, the first working day after the week.",
          "dueWorkingDays": 1,
          "steps": [
            {
              "type": "remind",
              "daysBefore": 0
            },
            {
              "type": "escalate",
              "to": "owner",
              "daysAfter": 1
            },
            {
              "type": "check",
              "changePct": 40,
              "outsideTarget": true
            },
            {
              "type": "publish",
              "lock": false
            }
          ]
        }
      }
    ]
  }
}
