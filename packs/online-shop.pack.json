{
  "format": "ziffr.pack/2",
  "id": "ziffr/online-shop",
  "name": "Online shop",
  "version": "1.2.0",
  "summary": "Orders, revenue by channel, average order value, conversion, returns and sessions, with a weekly dashboard and a Workflow that asks for the week's numbers on Monday.",
  "author": {
    "name": "Ziffr"
  },
  "license": "CC-BY-4.0",
  "ziffr": ">=0.11",
  "audience": {
    "industries": [
      "ecommerce",
      "retail"
    ],
    "segments": [
      "b2c"
    ]
  },
  "listing": {
    "homepage": "https://github.com/ziffr/ziffr/tree/main/packs"
  },
  "guide": {
    "whatItsFor": [
      {
        "type": "text",
        "text": "For an online shop that looks at its week: orders, revenue by channel, the average order, how many visitors buy and how much comes back."
      }
    ],
    "beforeYouStart": [
      {
        "type": "list",
        "items": [
          "The week's figures from your shop and your analytics: orders, online revenue, conversion rate, return rate and sessions.",
          "Free room for the Metrics in your Workspace's size: the Set up form says how many it makes and how many fit."
        ]
      }
    ],
    "firstSteps": [
      {
        "type": "heading",
        "text": "Start here"
      },
      {
        "type": "list",
        "numbered": true,
        "items": [
          "Open **Settings**, then **Packs**. Under this Pack, choose **Set up from this Pack**.",
          "Keep the Metrics you want ticked, up to all 6, with the dashboard **Shop weekly** and the Workflow **Monday numbers**. Tick **Ask me for their values** if you send the figures yourself, then choose **Set up**.",
          "To have someone else send a figure, open its Metric and add them under **Who submits**. Only a Submitter sees **Record a value** there.",
          "Send the first figures: open a Metric and choose **Record a value**, or answer the request Ziffr sends.",
          "Open **Dashboards** and then **Shop weekly**. It fills as values come in."
        ]
      }
    ],
    "eachPart": [
      {
        "type": "list",
        "items": [
          "**Orders**, **Online revenue** and **Sessions** by week.",
          "**Average order value**, which Ziffr works out as online revenue divided by orders.",
          "**Conversion rate** and **Return rate** as shares.",
          "The dashboard **Shop weekly**.",
          "The Workflow **Monday numbers**: due on Monday, with a reminder that day. A change of more than 40 % or a value outside its target is marked as unusual. A figure that is still missing after its Due Date is raised with the Metric's owner."
        ]
      }
    ],
    "questions": [
      {
        "type": "heading",
        "text": "How do I see revenue by channel?"
      },
      {
        "type": "text",
        "text": "Record **Online revenue** with a **Breakdown**, one line for each channel."
      }
    ]
  },
  "contents": {
    "metrics": [
      {
        "key": "orders",
        "metric": {
          "format": "ziffr.metric/1",
          "name": "Orders",
          "description": "Orders placed in the week, including those later cancelled or returned.",
          "category": "E-commerce",
          "industries": [
            "ecommerce",
            "retail"
          ],
          "period": "week",
          "aggregation": "sum",
          "polarity": "higher",
          "unit": "orders",
          "unitPosition": "after",
          "valueFormat": "number",
          "decimals": 0,
          "submissionRule": "overwrite",
          "sources": [
            "web_form",
            "mail",
            "slack",
            "telegram",
            "api"
          ]
        }
      },
      {
        "key": "revenue",
        "metric": {
          "format": "ziffr.metric/1",
          "name": "Online revenue",
          "description": "Revenue from online orders in the week, excluding VAT and shipping fees, before returns. Record it with a Breakdown by channel to see where it comes from.",
          "category": "E-commerce",
          "industries": [
            "ecommerce",
            "retail"
          ],
          "period": "week",
          "aggregation": "sum",
          "polarity": "higher",
          "unit": "€",
          "unitPosition": "after",
          "valueFormat": "currency",
          "decimals": 0,
          "submissionRule": "overwrite",
          "sources": [
            "web_form",
            "mail",
            "slack",
            "telegram",
            "api"
          ]
        }
      },
      {
        "key": "aov",
        "metric": {
          "format": "ziffr.metric/1",
          "name": "Average order value",
          "description": "Online revenue divided by the number of orders, in the week.",
          "category": "E-commerce",
          "period": "week",
          "aggregation": "none",
          "polarity": "higher",
          "unit": "€",
          "unitPosition": "after",
          "valueFormat": "currency",
          "decimals": 2,
          "submissionRule": "overwrite",
          "formula": "{revenue} / {orders}"
        }
      },
      {
        "key": "conversion",
        "metric": {
          "format": "ziffr.metric/1",
          "name": "Conversion rate",
          "description": "Share of website visitors who placed an order.",
          "category": "E-commerce",
          "industries": [
            "ecommerce"
          ],
          "period": "week",
          "aggregation": "none",
          "polarity": "higher",
          "unit": "%",
          "unitPosition": "after",
          "valueFormat": "percent",
          "decimals": 2,
          "submissionRule": "overwrite",
          "targetMin": 2.5,
          "sources": [
            "web_form",
            "mail",
            "slack",
            "telegram",
            "api"
          ]
        }
      },
      {
        "key": "return-rate",
        "metric": {
          "format": "ziffr.metric/1",
          "name": "Return rate",
          "description": "Items returned as a share of items sold, by the week of sale.",
          "category": "E-commerce",
          "industries": [
            "ecommerce",
            "retail"
          ],
          "period": "week",
          "aggregation": "none",
          "polarity": "lower",
          "unit": "%",
          "unitPosition": "after",
          "valueFormat": "percent",
          "decimals": 1,
          "submissionRule": "overwrite",
          "sources": [
            "web_form",
            "mail",
            "slack",
            "telegram",
            "api"
          ]
        }
      },
      {
        "key": "sessions",
        "metric": {
          "format": "ziffr.metric/1",
          "name": "Sessions",
          "description": "Visits to the online shop in the week; one person can have several.",
          "category": "E-commerce",
          "industries": [
            "ecommerce"
          ],
          "period": "week",
          "aggregation": "sum",
          "polarity": "higher",
          "unit": "sessions",
          "unitPosition": "after",
          "valueFormat": "number",
          "decimals": 0,
          "submissionRule": "overwrite",
          "sources": [
            "web_form",
            "mail",
            "slack",
            "telegram",
            "api"
          ]
        }
      }
    ],
    "dashboards": [
      {
        "key": "shop-weekly",
        "template": {
          "format": "ziffr.dashboard-template/1",
          "name": "Shop weekly",
          "description": "Orders, revenue and where it comes from, conversion and returns, week by week.",
          "slots": [
            {
              "label": "Online revenue",
              "suggests": "revenue"
            },
            {
              "label": "Orders",
              "suggests": "orders"
            },
            {
              "label": "Average order value",
              "suggests": "aov"
            },
            {
              "label": "Conversion rate",
              "suggests": "conversion"
            },
            {
              "label": "Return rate",
              "suggests": "return-rate"
            },
            {
              "label": "Sessions",
              "suggests": "sessions"
            }
          ],
          "widgets": [
            {
              "view": "number",
              "slots": [
                0
              ],
              "x": 0,
              "y": 0,
              "w": 3,
              "h": 4
            },
            {
              "view": "number",
              "slots": [
                1
              ],
              "x": 3,
              "y": 0,
              "w": 3,
              "h": 4
            },
            {
              "view": "number",
              "slots": [
                2
              ],
              "x": 6,
              "y": 0,
              "w": 3,
              "h": 4
            },
            {
              "view": "number",
              "slots": [
                3
              ],
              "x": 9,
              "y": 0,
              "w": 3,
              "h": 4
            },
            {
              "view": "line",
              "slots": [
                0
              ],
              "x": 0,
              "y": 4,
              "w": 8,
              "h": 6,
              "settings": {
                "window": 13,
                "showTarget": true
              }
            },
            {
              "view": "share",
              "slots": [
                0
              ],
              "x": 8,
              "y": 4,
              "w": 4,
              "h": 6
            },
            {
              "view": "bars",
              "slots": [
                5
              ],
              "x": 0,
              "y": 10,
              "w": 6,
              "h": 6,
              "settings": {
                "window": 13
              }
            },
            {
              "view": "line",
              "slots": [
                4
              ],
              "x": 6,
              "y": 10,
              "w": 6,
              "h": 6,
              "settings": {
                "window": 13,
                "showTarget": true
              }
            }
          ]
        }
      }
    ],
    "workflows": [
      {
        "key": "monday-numbers",
        "template": {
          "format": "ziffr.workflow-template/1",
          "name": "Monday numbers",
          "description": "The week's numbers are due on Monday, the first working day after the week.",
          "dueWorkingDays": 1,
          "steps": [
            {
              "type": "remind",
              "daysBefore": 0
            },
            {
              "type": "escalate",
              "to": "owner",
              "daysAfter": 1
            },
            {
              "type": "check",
              "changePct": 40,
              "outsideTarget": true
            },
            {
              "type": "publish",
              "lock": false
            }
          ]
        }
      }
    ]
  }
}
