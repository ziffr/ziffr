    "themes": [
      {
        "key": "board",
        "theme": {
          "format": "ziffr.theme/1",
          "name": "Board",
          "colors": {
            "canvas": "#F4F1EA",
            "surface": "#FFFFFF",
            "ink": "#1A1A1A",
            "muted": "#6B6B6B",
            "rule": "#D9D4C7",
            "accent": "#B4441C",
            "good": "#2E7D32",
            "bad": "#C62828",
            "band": "#E8E2D0",
            "data": [
              "#1F4E79",
              "#B4441C",
              "#5B7F3A",
              "#8A6D3B"
            ]
          },
          "fonts": {
            "heading": "source-serif",
            "body": "inter",
            "figures": "ibm-plex-mono"
          },
          "radius": 4,
          "cards": "flat",
          "slides": {
            "logoPosition": "top-right",
            "logoWidth": 120,
            "footer": "Board meeting",
            "showSlideNumber": true,
            "titleSize": 48,
            "bodySize": 22
          }
        }
      }
    ],
    "workflows": [
      {
        "key": "quarter-close",
        "template": {
          "format": "ziffr.workflow-template/1",
          "name": "Quarter close",
          "description": "Values due on the fifth working day after the quarter, checked, approved by one person, then locked.",
          "dueWorkingDays": 5,
          "steps": [
            {
              "type": "remind",
              "daysBefore": 1
            },
            {
              "type": "escalate",
              "to": "stand-in",
              "daysAfter": 1
            },
            {
              "type": "check",
              "changePct": 30,
              "outsideTarget": true
            },
            {
              "type": "approve",
              "approvers": 1,
              "values": "every"
            },
            {
              "type": "publish",
              "lock": true
            }
          ]
        }
      }
    ]
  }
