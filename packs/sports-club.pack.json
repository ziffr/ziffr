{
  "format": "ziffr.pack/3",
  "id": "ziffr/sports-club",
  "name": "Sports club",
  "version": "1.5.0",
  "summary": "Members, joiners and leavers, attendance per training, fees received and volunteer hours, with a season dashboard and a Workflow that asks each coach for attendance after training.",
  "author": {
    "name": "Ziffr"
  },
  "license": "CC-BY-4.0",
  "ziffr": ">=0.21",
  "audience": {
    "segments": [
      "non_profit"
    ]
  },
  "listing": {
    "homepage": "https://github.com/ziffr/ziffr/tree/main/packs"
  },
  "setUp": {
    "line": "Members, training attendance and fees in one place.",
    "happens": [
      "Attendance is asked for after each week of training",
      "Each month members, fees and volunteer hours are asked for",
      "The season dashboard fills in"
    ],
    "needs": [
      "Attendance at training",
      "Member numbers, fees received and volunteer hours"
    ]
  },
  "guide": {
    "whatItsFor": [
      {
        "type": "text",
        "text": "For a sports club. After each week of training the coaches are asked for attendance. Members, fees and volunteer hours come in monthly. A season dashboard shows them together."
      }
    ],
    "beforeYouStart": [
      {
        "type": "list",
        "items": [
          "The coaches who report attendance.",
          "Members, joiners, leavers, fees received and volunteer hours.",
          "Room for 6 Metrics in your Workspace."
        ]
      }
    ],
    "questions": [
      {
        "type": "heading",
        "text": "Does a coach need an account?"
      },
      {
        "type": "text",
        "text": "No. A coach can be a **Contact**, who answers by a personal form link, email or chat."
      }
    ]
  },
  "contents": {
    "metrics": [
      {
        "key": "members",
        "comesFrom": { "by": "person" },
        "metric": {
          "format": "ziffr.metric/2",
          "name": "Members",
          "description": "Members with a paid or exempt membership at month end.",
          "calculationNote": "People whose membership runs on the last day of the month, paying or exempt from the fee. Former members and trial participants are left out.",
          "category": "Club",
          "period": "month",
          "aggregation": "last",
          "polarity": "higher",
          "unit": "members",
          "unitPosition": "after",
          "valueFormat": "number",
          "decimals": 0,
          "submissionRule": "overwrite",
          "sources": [
            "web_form",
            "mail",
            "slack",
            "telegram",
            "api"
          ]
        }
      },
      {
        "key": "joiners",
        "comesFrom": { "by": "person" },
        "metric": {
          "format": "ziffr.metric/2",
          "name": "Joiners",
          "description": "People whose membership began in the month.",
          "calculationNote": "People whose membership began in the month, including former members who came back.",
          "category": "Club",
          "period": "month",
          "aggregation": "sum",
          "polarity": "higher",
          "unit": "people",
          "unitPosition": "after",
          "valueFormat": "number",
          "decimals": 0,
          "submissionRule": "overwrite",
          "sources": [
            "web_form",
            "mail",
            "slack",
            "telegram",
            "api"
          ]
        }
      },
      {
        "key": "leavers",
        "comesFrom": { "by": "person" },
        "metric": {
          "format": "ziffr.metric/2",
          "name": "Leavers",
          "description": "People whose membership ended in the month.",
          "calculationNote": "People whose membership ended in the month, counted on the day it ended and not on the day notice was given.",
          "category": "Club",
          "period": "month",
          "aggregation": "sum",
          "polarity": "lower",
          "unit": "people",
          "unitPosition": "after",
          "valueFormat": "number",
          "decimals": 0,
          "submissionRule": "overwrite",
          "sources": [
            "web_form",
            "mail",
            "slack",
            "telegram",
            "api"
          ]
        }
      },
      {
        "key": "attendance",
        "comesFrom": { "by": "person" },
        "metric": {
          "format": "ziffr.metric/2",
          "name": "Attendance per training",
          "description": "Players at the week's training sessions, counted by the coach after each session.",
          "calculationNote": "The players present, counted by the coach after each session, added up over the sessions of the week. Coaches and spectators are not counted.",
          "category": "Club",
          "period": "week",
          "aggregation": "sum",
          "polarity": "higher",
          "unit": "players",
          "unitPosition": "after",
          "valueFormat": "number",
          "decimals": 0,
          "submissionRule": "overwrite",
          "sources": [
            "web_form",
            "mail",
            "slack",
            "telegram",
            "api"
          ]
        }
      },
      {
        "key": "fees",
        "comesFrom": { "by": "person" },
        "metric": {
          "format": "ziffr.metric/2",
          "name": "Fees received",
          "description": "Membership fees received in the month.",
          "calculationNote": "Membership fees that arrived in the month, whatever period they are for. Donations, sponsoring and event income are left out.",
          "category": "Club",
          "period": "month",
          "aggregation": "sum",
          "polarity": "higher",
          "unit": "€",
          "unitPosition": "after",
          "valueFormat": "currency",
          "decimals": 0,
          "submissionRule": "overwrite",
          "sources": [
            "web_form",
            "mail",
            "slack",
            "telegram",
            "api"
          ]
        }
      },
      {
        "key": "volunteer-hours",
        "comesFrom": { "by": "person" },
        "metric": {
          "format": "ziffr.metric/2",
          "name": "Volunteer hours",
          "description": "Hours volunteers gave the club in the month: coaching, events, the club house and the board.",
          "calculationNote": "Hours volunteers report for the month, for coaching, events, the club house and the board. Paid hours are left out.",
          "category": "Club",
          "period": "month",
          "aggregation": "sum",
          "polarity": "higher",
          "unit": "hours",
          "unitPosition": "after",
          "valueFormat": "number",
          "decimals": 0,
          "submissionRule": "overwrite",
          "sources": [
            "web_form",
            "mail",
            "slack",
            "telegram",
            "api"
          ]
        }
      }
    ],
    "dashboards": [
      {
        "key": "season-overview",
        "template": {
          "format": "ziffr.dashboard-template/1",
          "name": "Season overview",
          "description": "Members coming and going, attendance at training, fees and the hours volunteers give.",
          "slots": [
            {
              "label": "Members",
              "suggests": "members"
            },
            {
              "label": "Joiners",
              "suggests": "joiners"
            },
            {
              "label": "Leavers",
              "suggests": "leavers"
            },
            {
              "label": "Attendance per training",
              "suggests": "attendance"
            },
            {
              "label": "Fees received",
              "suggests": "fees"
            },
            {
              "label": "Volunteer hours",
              "suggests": "volunteer-hours"
            }
          ],
          "widgets": [
            {
              "view": "number",
              "slots": [
                0
              ],
              "x": 0,
              "y": 0,
              "w": 4,
              "h": 4
            },
            {
              "view": "number",
              "slots": [
                4
              ],
              "x": 4,
              "y": 0,
              "w": 4,
              "h": 4
            },
            {
              "view": "number",
              "slots": [
                5
              ],
              "x": 8,
              "y": 0,
              "w": 4,
              "h": 4
            },
            {
              "view": "line",
              "slots": [
                0
              ],
              "x": 0,
              "y": 4,
              "w": 6,
              "h": 6,
              "settings": {
                "window": 12
              }
            },
            {
              "view": "bars",
              "slots": [
                3
              ],
              "x": 6,
              "y": 4,
              "w": 6,
              "h": 6,
              "settings": {
                "window": 20
              }
            },
            {
              "view": "bars",
              "slots": [
                1
              ],
              "x": 0,
              "y": 10,
              "w": 6,
              "h": 6,
              "settings": {
                "window": 12
              }
            },
            {
              "view": "bars",
              "slots": [
                2
              ],
              "x": 6,
              "y": 10,
              "w": 6,
              "h": 6,
              "settings": {
                "window": 12
              }
            }
          ]
        }
      }
    ],
    "workflows": [
      {
        "key": "after-training",
        "template": {
          "format": "ziffr.workflow-template/1",
          "name": "After training",
          "description": "Each coach gives the week's attendance by the next working day; the club's secretary steps in when it is late.",
          "dueWorkingDays": 1,
          "steps": [
            {
              "type": "remind",
              "daysBefore": 0
            },
            {
              "type": "escalate",
              "to": "stand-in",
              "daysAfter": 1
            },
            {
              "type": "publish",
              "lock": false
            }
          ]
        }
      }
    ]
  }
}
