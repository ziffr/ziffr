{
  "format": "ziffr.pack/3",
  "id": "ziffr/fulfilment",
  "name": "Operations and fulfilment",
  "version": "1.5.0",
  "summary": "Orders shipped, on-time delivery, backlog, stock, stock-outs, output, defects and downtime, with a weekly dashboard and a Workflow that asks for last week's figures on Monday.",
  "author": {
    "name": "Ziffr"
  },
  "license": "CC-BY-4.0",
  "ziffr": ">=0.21",
  "audience": {
    "industries": [
      "ecommerce",
      "retail",
      "wholesale",
      "manufacturing",
      "logistics"
    ],
    "functions": [
      "operations"
    ]
  },
  "listing": {
    "homepage": "https://github.com/ziffr/ziffr/tree/main/packs"
  },
  "setUp": {
    "line": "See every week what went out and what is still waiting.",
    "happens": [
      "Last week's figures are asked for on Monday",
      "The dashboard shows deliveries, backlog, stock and output"
    ],
    "needs": [
      "Orders shipped, on-time delivery, backlog and stock",
      "Units produced, defect rate and downtime"
    ]
  },
  "guide": {
    "whatItsFor": [
      {
        "type": "text",
        "text": "For a team that ships or makes things. Every Monday last week's figures are asked for, and a dashboard shows deliveries, backlog, stock and output."
      }
    ],
    "beforeYouStart": [
      {
        "type": "list",
        "items": [
          "Orders shipped, on-time delivery, backlog, stock value and stock-outs.",
          "Units produced, defect rate and downtime.",
          "Room for 8 Metrics in your Workspace."
        ]
      }
    ],
    "questions": [
      {
        "type": "heading",
        "text": "What if we do not produce anything?"
      },
      {
        "type": "text",
        "text": "Archive **Units produced**, **Defect rate** and **Downtime**. Nobody is then asked for them."
      }
    ]
  },
  "contents": {
    "metrics": [
      {
        "key": "orders-shipped",
        "comesFrom": { "by": "person" },
        "metric": {
          "format": "ziffr.metric/2",
          "name": "Orders shipped",
          "description": "Orders handed to the carrier in the week.",
          "calculationNote": "Orders handed to the carrier from Monday to Sunday, each counted once, however many parcels it needed. Cancelled orders and replacement parcels are left out.",
          "category": "Operations",
          "period": "week",
          "aggregation": "sum",
          "polarity": "higher",
          "valueFormat": "number",
          "decimals": 0,
          "submissionRule": "overwrite",
          "sources": [
            "web_form",
            "mail",
            "slack",
            "telegram",
            "api"
          ],
          "tags": [
            "Operations",
            "Weekly report"
          ]
        }
      },
      {
        "key": "on-time",
        "comesFrom": { "by": "person" },
        "metric": {
          "format": "ziffr.metric/2",
          "name": "On-time delivery",
          "description": "The share of orders delivered by the promised date, in the week.",
          "calculationNote": "Orders delivered on or before the promised date, divided by all orders due for delivery in the week, in percent. An order delivered in parts is on time only when its last part is.",
          "category": "Operations",
          "period": "week",
          "aggregation": "average",
          "polarity": "higher",
          "unit": "%",
          "unitPosition": "after",
          "valueFormat": "percent",
          "decimals": 0,
          "submissionRule": "overwrite",
          "targetMin": 95,
          "sources": [
            "web_form",
            "mail",
            "slack",
            "telegram",
            "api"
          ],
          "tags": [
            "Operations",
            "Weekly report"
          ]
        }
      },
      {
        "key": "backlog",
        "comesFrom": { "by": "person" },
        "metric": {
          "format": "ziffr.metric/2",
          "name": "Order backlog",
          "description": "Orders received and not yet shipped, at the end of the week.",
          "calculationNote": "Orders received and not cancelled that have not been handed to the carrier by Sunday evening, whether or not they are late.",
          "category": "Operations",
          "period": "week",
          "aggregation": "last",
          "polarity": "lower",
          "valueFormat": "number",
          "decimals": 0,
          "submissionRule": "overwrite",
          "sources": [
            "web_form",
            "mail",
            "slack",
            "telegram",
            "api"
          ],
          "tags": [
            "Operations"
          ]
        }
      },
      {
        "key": "stock-value",
        "comesFrom": { "by": "person" },
        "metric": {
          "format": "ziffr.metric/2",
          "name": "Stock value",
          "description": "The value of stock on hand at the end of the week, at cost.",
          "calculationNote": "The units on hand on Sunday evening at what they cost to buy or make, not at their sales price. Goods ordered and not yet received are left out.",
          "category": "Operations",
          "period": "week",
          "aggregation": "last",
          "polarity": "target",
          "unit": "€",
          "unitPosition": "after",
          "valueFormat": "currency",
          "decimals": 0,
          "submissionRule": "overwrite",
          "sources": [
            "web_form",
            "mail",
            "slack",
            "telegram",
            "api"
          ],
          "tags": [
            "Operations"
          ]
        }
      },
      {
        "key": "stock-outs",
        "comesFrom": { "by": "person" },
        "metric": {
          "format": "ziffr.metric/2",
          "name": "Stock-outs",
          "description": "Products that were out of stock at some point in the week.",
          "calculationNote": "Products that had none available at any time from Monday to Sunday, each counted once a week. Discontinued products are left out.",
          "category": "Operations",
          "period": "week",
          "aggregation": "sum",
          "polarity": "lower",
          "valueFormat": "number",
          "decimals": 0,
          "submissionRule": "overwrite",
          "sources": [
            "web_form",
            "mail",
            "slack",
            "telegram",
            "api"
          ],
          "tags": [
            "Operations"
          ]
        }
      },
      {
        "key": "output",
        "comesFrom": { "by": "person" },
        "metric": {
          "format": "ziffr.metric/2",
          "name": "Units produced",
          "description": "Units made or packed in the week.",
          "calculationNote": "Units finished or packed from Monday to Sunday that passed the check. Rework of an earlier unit is not counted again.",
          "category": "Operations",
          "period": "week",
          "aggregation": "sum",
          "polarity": "higher",
          "valueFormat": "number",
          "decimals": 0,
          "submissionRule": "overwrite",
          "sources": [
            "web_form",
            "mail",
            "slack",
            "telegram",
            "api"
          ],
          "tags": [
            "Operations"
          ]
        }
      },
      {
        "key": "defect-rate",
        "comesFrom": { "by": "person" },
        "metric": {
          "format": "ziffr.metric/2",
          "name": "Defect rate",
          "description": "Units found defective, as a share of the units produced in the week.",
          "calculationNote": "Units found defective divided by all units produced in the week, in percent, whether they were repaired or scrapped.",
          "category": "Operations",
          "period": "week",
          "aggregation": "average",
          "polarity": "lower",
          "unit": "%",
          "unitPosition": "after",
          "valueFormat": "percent",
          "decimals": 1,
          "submissionRule": "overwrite",
          "targetMax": 2,
          "sources": [
            "web_form",
            "mail",
            "slack",
            "telegram",
            "api"
          ],
          "tags": [
            "Operations",
            "Weekly report"
          ]
        }
      },
      {
        "key": "downtime",
        "comesFrom": { "by": "person" },
        "metric": {
          "format": "ziffr.metric/2",
          "name": "Downtime",
          "description": "Hours that lines or machines stood still when they should have run, in the week.",
          "calculationNote": "Hours of planned running time in which a line or machine stood still, added up over all of them. Planned maintenance and shifts nobody was scheduled for are left out.",
          "category": "Operations",
          "period": "week",
          "aggregation": "sum",
          "polarity": "lower",
          "unit": "hours",
          "unitPosition": "after",
          "valueFormat": "number",
          "decimals": 1,
          "submissionRule": "overwrite",
          "sources": [
            "web_form",
            "mail",
            "slack",
            "telegram",
            "api"
          ],
          "tags": [
            "Operations"
          ]
        }
      }
    ],
    "dashboards": [
      {
        "key": "operations-weekly",
        "template": {
          "format": "ziffr.dashboard-template/1",
          "name": "Operations weekly",
          "description": "What went out, whether it arrived on time, what is waiting, and how the line is running.",
          "slots": [
            {
              "label": "Orders shipped",
              "suggests": "orders-shipped"
            },
            {
              "label": "On-time delivery",
              "suggests": "on-time"
            },
            {
              "label": "Order backlog",
              "suggests": "backlog"
            },
            {
              "label": "Defect rate",
              "suggests": "defect-rate"
            },
            {
              "label": "Units produced",
              "suggests": "output"
            },
            {
              "label": "Downtime",
              "suggests": "downtime"
            }
          ],
          "widgets": [
            {
              "view": "number",
              "slots": [
                0
              ],
              "x": 0,
              "y": 0,
              "w": 3,
              "h": 4
            },
            {
              "view": "gauge",
              "slots": [
                1
              ],
              "x": 3,
              "y": 0,
              "w": 3,
              "h": 4
            },
            {
              "view": "number",
              "slots": [
                2
              ],
              "x": 6,
              "y": 0,
              "w": 3,
              "h": 4
            },
            {
              "view": "gauge",
              "slots": [
                3
              ],
              "x": 9,
              "y": 0,
              "w": 3,
              "h": 4
            },
            {
              "view": "line",
              "slots": [
                0
              ],
              "x": 0,
              "y": 4,
              "w": 8,
              "h": 6,
              "settings": {
                "window": 12
              }
            },
            {
              "view": "number",
              "slots": [
                5
              ],
              "x": 8,
              "y": 4,
              "w": 4,
              "h": 6
            },
            {
              "view": "bars",
              "slots": [
                4
              ],
              "x": 0,
              "y": 10,
              "w": 12,
              "h": 6,
              "settings": {
                "window": 12
              }
            }
          ]
        }
      }
    ],
    "workflows": [
      {
        "key": "monday-operations-figures",
        "template": {
          "format": "ziffr.workflow-template/1",
          "name": "Monday operations figures",
          "description": "Last week's operations figures are asked for on Monday and published.",
          "dueWorkingDays": 1,
          "steps": [
            {
              "type": "remind",
              "daysBefore": 1
            },
            {
              "type": "escalate",
              "to": "owner",
              "daysAfter": 1
            },
            {
              "type": "publish",
              "lock": false
            }
          ]
        }
      }
    ]
  },
  "feeds": [
    {
      "template": "google-sheets",
      "fills": [
        "orders-shipped",
        "on-time",
        "backlog",
        "stock-value"
      ]
    }
  ]
}
