    "views": [
      {
        "key": "growth-trend",
        "design": {
          "format": "ziffr.view/1",
          "name": "Growth, smoothed",
          "description": "The Metric's growth on the month before, and its three-month moving average.",
          "kind": "analysis",
          "slots": [
            {
              "label": "Metric",
              "metrics": "one"
            }
          ],
          "size": {
            "w": 12,
            "h": 7
          },
          "options": {
            "window": {
              "label": "Periods",
              "default": 12
            }
          },
          "analysis": {
            "format": "ziffr.analysis/1",
            "name": "Growth, smoothed",
            "description": "Growth on the month before, and its three-month moving average.",
            "slots": [
              {
                "label": "Metric"
              }
            ],
            "steps": [
              {
                "id": "growth",
                "fn": "growth",
                "of": "slot1"
              },
              {
                "id": "smooth",
                "fn": "movingAverage",
                "of": "growth",
                "window": 3
              }
            ],
            "outputs": [
              {
                "step": "growth",
                "label": "Growth",
                "unit": "percent"
              },
              {
                "step": "smooth",
                "label": "Three-month average",
                "unit": "percent"
              }
            ]
          },
          "parts": [
            {
              "mark": "plot",
              "axes": "regular",
              "grid": "horizontal",
              "scale": "auto",
              "marks": [
                {
                  "mark": "bar",
                  "show": "recipe.growth",
                  "tone": "muted"
                },
                {
                  "mark": "line",
                  "show": "recipe.smooth",
                  "tone": "data",
                  "weight": "strong"
                }
              ]
            },
            {
              "mark": "text",
              "style": "caption",
              "content": [
                "Three-month average now ",
                {
                  "show": "recipe.smooth",
                  "style": "strong"
                }
              ]
            }
          ]
        }
      }
    ],
