{
  "format": "ziffr.pack/1",
  "id": "ziffr/saas-metrics",
  "name": "SaaS metrics",
  "version": "2.0.0",
  "summary": "MRR and its movements, customers, churn, retention, CAC, cash and runway, with a monthly management report as dashboard and deck, a quarterly board deck, and the Workflows for the monthly and quarterly close.",
  "author": {
    "name": "Ziffr"
  },
  "license": "CC-BY-4.0",
  "ziffr": ">=0.11",
  "logo": "data:image/svg+xml;base64,",
  "listing": {
    "homepage": "https://github.com/ziffr/ziffr/tree/main/packs"
  },
  "contents": {
    "metrics": [
      {
        "key": "mrr",
        "metric": {
          "format": "ziffr.metric/1",
          "name": "Monthly recurring revenue",
          "description": "Recurring subscription revenue at month end.",
          "category": "Sales",
          "industries": [
            "saas"
          ],
          "period": "month",
          "aggregation": "last",
          "polarity": "higher",
          "unit": "€",
          "unitPosition": "after",
          "valueFormat": "currency",
          "decimals": 0,
          "submissionRule": "overwrite",
          "sources": [
            "web_form",
            "mail",
            "slack",
            "telegram",
            "api"
          ],
          "tags": [
            "SaaS",
            "Revenue",
            "Monthly report",
            "Board"
          ]
        }
      },
      {
        "key": "arr",
        "metric": {
          "format": "ziffr.metric/1",
          "name": "Annual recurring revenue",
          "description": "Monthly recurring revenue at month end times twelve.",
          "category": "Sales",
          "industries": [
            "saas"
          ],
          "tags": [
            "SaaS",
            "Revenue",
            "Board"
          ],
          "period": "month",
          "aggregation": "none",
          "polarity": "higher",
          "unit": "€",
          "unitPosition": "after",
          "valueFormat": "currency",
          "decimals": 0,
          "submissionRule": "overwrite",
          "formula": "{mrr} * 12"
        }
      },
      {
        "key": "new-mrr",
        "metric": {
          "format": "ziffr.metric/1",
          "name": "New MRR",
          "description": "Monthly recurring revenue added in the month by customers who paid for the first time.",
          "category": "Sales",
          "industries": [
            "saas"
          ],
          "period": "month",
          "aggregation": "sum",
          "polarity": "higher",
          "unit": "€",
          "unitPosition": "after",
          "valueFormat": "currency",
          "decimals": 0,
          "submissionRule": "overwrite",
          "sources": [
            "web_form",
            "mail",
            "slack",
            "telegram",
            "api"
          ],
          "tags": [
            "SaaS",
            "Revenue",
            "Monthly report"
          ]
        }
      },
      {
        "key": "expansion-mrr",
        "metric": {
          "format": "ziffr.metric/1",
          "name": "Expansion revenue",
          "description": "Monthly recurring revenue added in the month by existing customers through upgrades and add-ons; new customers are not included.",
          "category": "Sales",
          "industries": [
            "saas"
          ],
          "period": "month",
          "aggregation": "sum",
          "polarity": "higher",
          "unit": "€",
          "unitPosition": "after",
          "valueFormat": "currency",
          "decimals": 0,
          "submissionRule": "overwrite",
          "sources": [
            "web_form",
            "mail",
            "slack",
            "telegram",
            "api"
          ],
          "tags": [
            "SaaS",
            "Revenue",
            "Monthly report"
          ]
        }
      },
      {
        "key": "churned-mrr",
        "metric": {
          "format": "ziffr.metric/1",
          "name": "Churned MRR",
          "description": "Monthly recurring revenue lost in the month to cancellations and downgrades.",
          "category": "Customers",
          "industries": [
            "saas"
          ],
          "period": "month",
          "aggregation": "sum",
          "polarity": "lower",
          "unit": "€",
          "unitPosition": "after",
          "valueFormat": "currency",
          "decimals": 0,
          "submissionRule": "overwrite",
          "sources": [
            "web_form",
            "mail",
            "slack",
            "telegram",
            "api"
          ],
          "tags": [
            "SaaS",
            "Customers",
            "Monthly report"
          ]
        }
      },
      {
        "key": "customers",
        "metric": {
          "format": "ziffr.metric/1",
          "name": "Active customers",
          "description": "Customers with a paying contract or at least one order in the last twelve months, at period end.",
          "category": "Customers",
          "period": "month",
          "aggregation": "last",
          "polarity": "higher",
          "unit": "customers",
          "unitPosition": "after",
          "valueFormat": "number",
          "decimals": 0,
          "submissionRule": "overwrite",
          "sources": [
            "web_form",
            "mail",
            "slack",
            "telegram",
            "api"
          ],
          "tags": [
            "SaaS",
            "Customers",
            "Monthly report",
            "Board"
          ]
        }
      },
      {
        "key": "logo-churn",
        "metric": {
          "format": "ziffr.metric/1",
          "name": "Churn rate",
          "description": "Share of subscribers who cancelled during the month.",
          "category": "Customers",
          "industries": [
            "saas"
          ],
          "period": "month",
          "aggregation": "none",
          "polarity": "lower",
          "unit": "%",
          "unitPosition": "after",
          "valueFormat": "percent",
          "decimals": 1,
          "submissionRule": "overwrite",
          "targetMax": 3,
          "sources": [
            "web_form",
            "mail",
            "slack",
            "telegram",
            "api"
          ],
          "tags": [
            "SaaS",
            "Customers",
            "Monthly report",
            "Board"
          ]
        }
      },
      {
        "key": "nrr",
        "metric": {
          "format": "ziffr.metric/1",
          "name": "Net revenue retention",
          "description": "Recurring revenue now from customers who were customers twelve months ago, as a share of their recurring revenue then; expansion counts, new customers do not.",
          "category": "Customers",
          "industries": [
            "saas"
          ],
          "period": "month",
          "aggregation": "none",
          "polarity": "higher",
          "unit": "%",
          "unitPosition": "after",
          "valueFormat": "percent",
          "decimals": 0,
          "submissionRule": "overwrite",
          "targetMin": 100,
          "sources": [
            "web_form",
            "mail",
            "slack",
            "telegram",
            "api"
          ],
          "tags": [
            "SaaS",
            "Customers",
            "Monthly report",
            "Board"
          ]
        }
      },
      {
        "key": "cac",
        "metric": {
          "format": "ziffr.metric/1",
          "name": "Customer acquisition cost",
          "description": "Sales and marketing costs of the month divided by the new customers won in it.",
          "category": "Marketing",
          "period": "month",
          "aggregation": "none",
          "polarity": "lower",
          "unit": "€",
          "unitPosition": "after",
          "valueFormat": "currency",
          "decimals": 0,
          "submissionRule": "overwrite",
          "sources": [
            "web_form",
            "mail",
            "slack",
            "telegram",
            "api"
          ],
          "tags": [
            "SaaS",
            "Efficiency",
            "Monthly report"
          ]
        }
      },
      {
        "key": "cac-payback",
        "metric": {
          "format": "ziffr.metric/1",
          "name": "CAC payback",
          "description": "Months of a new customer's gross margin it takes to earn back what it cost to win them: customer acquisition cost divided by monthly gross margin per new account.",
          "category": "Marketing",
          "industries": [
            "saas"
          ],
          "period": "month",
          "aggregation": "none",
          "polarity": "lower",
          "unit": "months",
          "unitPosition": "after",
          "valueFormat": "number",
          "decimals": 1,
          "submissionRule": "overwrite",
          "tags": [
            "SaaS",
            "Efficiency",
            "Monthly report",
            "Board"
          ],
          "targetMax": 18,
          "sources": [
            "web_form",
            "mail",
            "slack",
            "telegram",
            "api"
          ]
        }
      },
      {
        "key": "arpa",
        "metric": {
          "format": "ziffr.metric/1",
          "name": "Average revenue per account",
          "description": "Monthly recurring revenue at month end divided by paying accounts at month end.",
          "category": "Product",
          "period": "month",
          "aggregation": "none",
          "polarity": "higher",
          "unit": "€",
          "unitPosition": "after",
          "valueFormat": "currency",
          "decimals": 0,
          "submissionRule": "overwrite",
          "formula": "{mrr} / {customers}",
          "tags": [
            "SaaS",
            "Revenue",
            "Monthly report"
          ]
        }
      },
      {
        "key": "cash",
        "metric": {
          "format": "ziffr.metric/1",
          "name": "Cash balance",
          "description": "Cash across all bank accounts at period end.",
          "category": "Finance",
          "period": "month",
          "aggregation": "last",
          "polarity": "higher",
          "unit": "€",
          "unitPosition": "after",
          "valueFormat": "currency",
          "decimals": 0,
          "submissionRule": "overwrite",
          "targetMin": 50000,
          "sources": [
            "web_form",
            "mail",
            "slack",
            "telegram",
            "api"
          ],
          "tags": [
            "SaaS",
            "Finance",
            "Monthly report",
            "Board"
          ],
          "industries": [
            "saas"
          ]
        }
      },
      {
        "key": "runway",
        "metric": {
          "format": "ziffr.metric/1",
          "name": "Cash runway",
          "description": "Months the cash balance lasts at the average net burn of the last three months.",
          "category": "Finance",
          "period": "month",
          "aggregation": "last",
          "polarity": "higher",
          "unit": "months",
          "unitPosition": "after",
          "valueFormat": "number",
          "decimals": 1,
          "submissionRule": "overwrite",
          "targetMin": 12,
          "sources": [
            "web_form",
            "mail",
            "slack",
            "telegram",
            "api"
          ],
          "tags": [
            "SaaS",
            "Finance",
            "Monthly report",
            "Board"
          ],
          "industries": [
            "saas"
          ]
        }
      }
    ],
