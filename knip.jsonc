// knip (#177, CONTRIBUTING "Code health"): no unused file, export, type or dependency. `pnpm health` runs it, and CI
// fails on any finding. Something kept on purpose is listed here, with the reason.
{
  "$schema": "https://unpkg.com/knip@6.45.1/schema.json",
  "workspaces": {
    ".": {
      // Scripts people and workflows run by path, and the self-hosting image's steps (docker/Dockerfile).
      "entry": ["scripts/*.mjs", ".github/scripts/*.mjs", "docker/*.mjs", "scripts/automation-templates/generate.mjs"],
      // The workflows' own JavaScript (n8n Code nodes), read as text by scripts/automation-templates/generate.mjs.
      "ignore": ["scripts/automation-templates/{code,helpers}/*.js"],
      // scripts/code-health.mjs runs each package's own ESLint, from inside that package.
      "ignoreBinaries": ["eslint"]
    },
    "packages/core": {
      // Stryker loads the mutation test config by the name in stryker.config.mjs, which knip does not follow.
      "entry": ["vitest.mutation.config.ts"],
      // The Marketplace's test makes a TLS certificate for its own server with the system's openssl, when there is one.
      "ignoreBinaries": ["openssl"]
    },
    "apps/web": {
      // The service worker is served from public/ and registered by its address, not imported.
      "entry": ["public/sw.js"],
      // The UI kit (shadcn): its components export every part, used or not, so a new screen can take them as they are.
      "ignore": ["src/components/ui/**"],
      // eslint-config-next is loaded by name through FlatCompat (eslint.config.mjs); flag-icons is the source of the
      // flags copied into public/flags (NOTICE), kept so its version and licence stay on record.
      "ignoreDependencies": ["eslint-config-next", "flag-icons"]
    },
    "apps/docs": {
      // The docs site (#551): scripts/sync.mjs reads landing.mdx as text and copies it into the content folder.
      "entry": ["scripts/*.mjs"],
      "ignore": ["landing.mdx"]
    },
    "packages/*": {}
  }
}
